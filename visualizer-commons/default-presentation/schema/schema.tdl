      DAHN.DefaultTheme.PropertiesRowGap.ThemeTokenAssignment,
      DAHN.DefaultTheme.PropertiesHeadingFontSize.ThemeTokenAssignment,
      DAHN.DefaultTheme.PropertiesHeadingFontWeight.ThemeTokenAssignment,
      DAHN.DefaultTheme.PropertyColumnGap.ThemeTokenAssignment,
      DAHN.DefaultTheme.PropertyNameMinWidth.ThemeTokenAssignment,
      DAHN.DefaultTheme.TableCellBorderStyle.ThemeTokenAssignment,
      DAHN.DefaultTheme.CollectionHeadingFontSize.ThemeTokenAssignment,
      DAHN.DefaultTheme.CollectionHeadingFontWeight.ThemeTokenAssignment,
      DAHN.DefaultTheme.TableHeaderFontWeight.ThemeTokenAssignment,

      DAHN.DefaultTheme.CanvasGap.ThemeTokenAssignment,
