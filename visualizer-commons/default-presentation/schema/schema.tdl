schema "MAP Default Presentation Commons-v0.1.0" {
  depends_on "MAP Design Tokens Schema-v0.1.0"
  depends_on "MAP Meta Design System Schema-v0.1.0"
  depends_on "MAP Theme Schema-v0.1.0"
  header {
    description: "A locally bundled Visualizer Commons contribution. It supplies an MDS contract and one compatible Theme without binding either to a Dancer or application."
  }
}

instance DAHN.DefaultMetaDesignSystem {
  type MetaDesignSystem.HolonType
  MetaDesignSystemName "DAHN.DefaultMetaDesignSystem-v0.1.0"
  relationships {
    DefinesDesignToken -> [
      CanvasGap.DesignToken,
      CanvasPadding.DesignToken,
      CanvasSurfaceBackground.DesignToken,
      CanvasTextColor.DesignToken,
      CollectionSurfaceBackground.DesignToken,
      CollectionTextColor.DesignToken,
      CollectionHeaderSurfaceBackground.DesignToken,
      TableHeaderSurfaceBackground.DesignToken,
      TableHeaderTextColor.DesignToken,
      TableCellBorderColor.DesignToken,
      TableCellBorderWidth.DesignToken,
      TableCellPadding.DesignToken
    ]
  }
}

instance DAHN.DefaultTheme {
  type Theme.HolonType
  ThemeName "DAHN.DefaultTheme"
  relationships {
    ForMetaDesignSystem -> DAHN.DefaultMetaDesignSystem
    HasThemeTokenAssignment -> [
      DAHN.DefaultTheme.CanvasGap.ThemeTokenAssignment,
      DAHN.DefaultTheme.CanvasPadding.ThemeTokenAssignment,
      DAHN.DefaultTheme.CanvasSurfaceBackground.ThemeTokenAssignment,
      DAHN.DefaultTheme.CanvasTextColor.ThemeTokenAssignment,
      DAHN.DefaultTheme.CollectionSurfaceBackground.ThemeTokenAssignment,
      DAHN.DefaultTheme.CollectionTextColor.ThemeTokenAssignment,
      DAHN.DefaultTheme.CollectionHeaderSurfaceBackground.ThemeTokenAssignment,
      DAHN.DefaultTheme.TableHeaderSurfaceBackground.ThemeTokenAssignment,
      DAHN.DefaultTheme.TableHeaderTextColor.ThemeTokenAssignment,
      DAHN.DefaultTheme.TableCellBorderColor.ThemeTokenAssignment,
      DAHN.DefaultTheme.TableCellBorderWidth.ThemeTokenAssignment,
      DAHN.DefaultTheme.TableCellPadding.ThemeTokenAssignment
    ]
  }
}

instance DAHN.DefaultTheme.CanvasGap.ThemeTokenAssignment {
  type ThemeTokenAssignment.HolonType
  PresentationValue "16px"
  relationships {
    ForDesignToken -> CanvasGap.DesignToken
  }
}
instance DAHN.DefaultTheme.CanvasPadding.ThemeTokenAssignment {
  type ThemeTokenAssignment.HolonType
  PresentationValue "20px"
  relationships {
    ForDesignToken -> CanvasPadding.DesignToken
  }
}
