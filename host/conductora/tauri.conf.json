{
	"$schema": "https://schema.tauri.app/config/2.0.0",
	"productName": "Map Holons",
	"mainBinaryName": "MAP",
	"version": "1.0.0",
	"identifier": "com.map-holons.tauri.dev",
	"build": {
		"frontendDist": "../ui/dist/map_sdk/browser",
		"devUrl": "http://localhost:4200",
		"beforeDevCommand": "npm run web:serve",
		"beforeBuildCommand": "npm run web:prod"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "MAP Holons client",
				"width": 1280,
				"height": 1040,
				"minWidth": 1100,
				"minHeight": 900,
				"resizable": true,
				"fullscreen": false,
				"theme": "Dark",
				"create": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'",
			"devCsp": "default-src * data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src * ipc: http://ipc.localhost ws: wss:"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"resources/bootstrap-import.schema.json": "resources/bootstrap-import.schema.json",
			"resources/core-schema-bootstrap": "resources/core-schema-bootstrap",
			"resources/space-imports.json": "resources/space-imports.json",
			"resources/schema-packages": "resources/schema-packages",
			"resources/house-troupe": "resources/house-troupe",
			"resources/visualizer-commons": "resources/visualizer-commons",
			"resources/dahn-visualizers": "resources/dahn-visualizers",
			"../../happ/workdir/map-holons.happ": "resources/map-holons.happ"
		},
		"externalBin": [],
		"copyright": "",
		"category": "DeveloperTool",
		"shortDescription": "",
		"longDescription": "",
		"macOS": {
			"bundleName": "MAP",
			"infoPlist": "Info.plist",
			"frameworks": [],
			"minimumSystemVersion": "14.0",
			"exceptionDomain": "",
			"signingIdentity": null,
			"providerShortName": null,
			"entitlements": null
		},
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": ""
		}
	}
}
