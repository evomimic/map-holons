{
  "name": "map-host",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng --project-dir=UI",
    "start": "npm run clean:hc && npm run tauri:serve",
    "clean:hc": "rm -f conductora/.hc*",
    "clean:hc:deep": "rm -f conductora/.hc* && rm -rf /tmp/conductora_dev",
    "mock": "cd ui && ng serve --configuration mock",
    "build": "cargo build --release",
    "check": "cargo check --workspace",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all --check",
    "test:unit": "npm run build:happ -w map-happ && cargo test --workspace",
    "test:unit:no-run": "cargo test --workspace --no-run",
    "regen:sdk-fixtures": "cargo test -p map_commands_wire --test generate_fixtures -- --ignored",
    "web:review": "cd ui && ng serve --configuration source-review --port 4201",
    "web:serve": "cd ui && ng serve --no-hmr",
    "web:test:dahn": "npm exec --prefix .. vitest -- run --root ui",
    "web:typecheck": "npx tsc -p ./ui/tsconfig.app.json --noEmit",
    "web:build": "cd ui && ng build --base-href ./",
    "web:dev": "npm run web:build",
    "web:prod": "npm run web:build -- -c production",
    "tauri": "tauri",
    "tauri:serve": "bash ./scripts/tauri-dev.sh",
    "clean": "npm run clean:hc:deep && npm run clean:rust:deep && npm run clean:ui",
    "clean:rust": "cargo clean",
    "clean:rust:deep": "npx rimraf target .cargo && cargo clean",
    "clean:ui": "npx rimraf ../node_modules",
    "tauri:bundle": "tauri build",
    "welcome:build": "npm run build:happ -w map-happ && tauri build --debug --bundles app --features local-constitution",
    "welcome:start": "bash ./scripts/welcome-start.sh"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ngrx/signals": "^22.0.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-fs": "^2",
    "ajv": "^8.17.1",
    "js-base64": "^3.7.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@tailwindcss/postcss": "^4.1.12",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
