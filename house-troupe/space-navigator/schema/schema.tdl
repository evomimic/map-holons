schema "MAP Space Navigator Schema-v0.1.0" {
  depends_on "MAP Core Schema-v0.0.7"
  depends_on "MAP Dance Schema-v0.1.0"
  depends_on "MAP Design Tokens Schema-v0.1.0"
  depends_on "MAP Meta Design System Schema-v0.1.0"
  depends_on "MAP Theme Schema-v0.1.0"
  depends_on "MAP DAHN Schema-v0.1.0"
  depends_on "MAP Dancer Schema-v0.1.0"
  header {
    description: "House Troupe semantic package for the Space Navigator's statically bundled Visualizer Holons and their locally resolvable implementation identities. These mappings resolve semantic VisualizerImplementation Holons; they do not create TypeScript-only Visualizer identities. The persisted TableCollectionVisualizer key identifies the current table-oriented Collection presentation strategy; shape-based collection applicability is deferred."
  }
}

holon SpaceNavigator.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends Dancer.HolonType
  header {
    description: "Concrete Dancer type for the Space Navigator home experience."
    display_name: "Space Navigator"
    display_plural: "Space Navigators"
    plural: "SpaceNavigators"
  }
}

instance SpaceNavigator.Dancer {
  type SpaceNavigator.HolonType
  relationships {
    OffersDance -> MaterializeVisualizer.DanceType
    AffordedByHolonSpace -> MAP.CoreSchemaSpace
    HasExperienceVisualizerSlot -> [SpaceNavigator.RootedNavigationSlot, SpaceNavigator.VisualizerInformationSlot]
    Requires -> [
      "MAP DAHN Schema-v0.1.0",
      "MAP Space Navigator Schema-v0.1.0"
    ]
  }
}

instance SpaceNavigator.RootedNavigationSlot {
  type VisualizerSlot.HolonType
  relationships {
    AcceptsVisualizerType -> RootedNavigationVisualizer.HolonType
  }
}

instance SpaceNavigator.CanvasVisualizer {
  type CanvasVisualizer.HolonType
  DisplayName "Space Navigator"
  VisualizerDescription "Explore the items in your space and follow their connections while keeping your place."
  relationships {
    ImplementedBy -> SpaceNavigatorTypeScript.VisualizerImplementation
    ConsumesDesignToken -> [
      CanvasGap.DesignToken,
      CanvasContentMinHeight.DesignToken,
      CanvasFontFamily.DesignToken,
      CanvasFontSize.DesignToken,
      CanvasFontWeight.DesignToken,
      CanvasHeadingFontWeight.DesignToken,
      CanvasLineHeight.DesignToken,
      CanvasPadding.DesignToken,
      CanvasSurfaceBackground.DesignToken,
      CanvasTextColor.DesignToken,
      SlotBorderColor.DesignToken,
      SlotBorderStyle.DesignToken,
      SlotBorderWidth.DesignToken,
      SlotPadding.DesignToken,
    ]
  }
}

instance TableCollectionVisualizer.CollectionVisualizer {
  type CollectionVisualizer.HolonType
  DisplayName "Table Collection"
  VisualizerDescription "Compare a group of items in a table. Sort the rows and open an item to see more."
  relationships {
    ImplementedBy -> TableCollectionTypeScript.VisualizerImplementation
    ConsumesDesignToken -> [
      ActionHoverSurfaceBackground.DesignToken,
      ActionTextColor.DesignToken,
      CollectionHeaderSurfaceBackground.DesignToken,
      CollectionHeadingFontSize.DesignToken,
      CollectionHeadingFontWeight.DesignToken,
      CollectionSurfaceBackground.DesignToken,
      CollectionTextColor.DesignToken,
      TableCellBorderColor.DesignToken,
      TableCellBorderStyle.DesignToken,
      TableCellBorderWidth.DesignToken,
      TableCellPadding.DesignToken,
      TableHeaderFontWeight.DesignToken,
      TableHeaderSurfaceBackground.DesignToken,
      TableHeaderTextColor.DesignToken,
    ]
  }
}

instance SpaceNavigatorTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.space-navigator"
  VisualizerArtifactDigest "sha256:c4b2c02ebe8bf36ed7bd9b4b232011635cd248313622c038a1b3182458a096d9"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

instance TableCollectionTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.table-collection"
  VisualizerArtifactDigest "sha256:4c39fedf4b1182342910590d2bb9a008765930e87ebb572927c0c5ea4cfb0419"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

// This presentation is selected only by the information slot, not ordinary Node slots.
holon VisualizerInspector.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Read-only semantic inspection of a shared Visualizer definition in an auxiliary experience region."
    display_name: "Visualizer Inspector"
    display_plural: "Visualizer Inspectors"
    plural: "VisualizerInspectors"
  }
}

instance SpaceNavigator.VisualizerInformationSlot {
  type VisualizerSlot.HolonType
  relationships {
    AcceptsVisualizerType -> VisualizerInspector.HolonType
  }
}

instance VisualizerInspector.Visualizer {
  type VisualizerInspector.HolonType
  DisplayName "Visualizer Inspector"
  VisualizerDescription "Explains the view you are using and what it helps you do."
  relationships {
    ApplicableToType -> Visualizer.HolonType
    ConsumesDesignToken -> [
      CanvasTextColor.DesignToken,
      PanelSurfaceBackground.DesignToken,
      SlotPadding.DesignToken,
      SlotBorderWidth.DesignToken,
      SlotBorderColor.DesignToken,
      ActionTextColor.DesignToken,
      ActionSurfaceBackground.DesignToken,
      ActionPaddingBlock.DesignToken,
      ActionPaddingInline.DesignToken,
    ]
    ImplementedBy -> VisualizerInspectorTypeScript.VisualizerImplementation
  }
}

instance VisualizerInspectorTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.visualizer-inspector"
  VisualizerArtifactDigest "sha256:10bdd96bbcd95235893b742fba8a37850dcbe5a259dedd6438f5767273c5f1ea"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}
