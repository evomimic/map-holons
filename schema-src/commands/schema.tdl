def relationship (CommandType.HolonType)-[CommandAffordedBy]->(HolonType.TypeDescriptor) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
    HasInverse -> AffordsCommand
  }
  extends DeclaredRelationshipType.RelationshipType
  source CommandType.HolonType
  target HolonType.TypeDescriptor
  deletion_semantic Allow
  header {
    description: "Declares the Core holon type that affords a CommandType, making the command discoverable through descriptor-local command affordance lookup."
    display_name: "CommandAffordedBy Relationship"
    display_plural: "CommandAffordedBy Relationships"
    plural: "CommandAffordedByRelationships"
  }
}


inverse relationship (HolonType.TypeDescriptor)-[AffordsCommand]->(CommandType.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source HolonType.TypeDescriptor
  target CommandType.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of CommandAffordedBy, from a Core holon type to the command it affords."
    display_name: "AffordsCommand Relationship"
    display_plural: "AffordsCommand Relationships"
    plural: "AffordsCommandRelationships"
  }
}


def relationship (CommandType.HolonType)-[CommandPayloadType]->(HolonType.TypeDescriptor) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ZeroOrOne.CardinalityConstraint
    HasInverse -> CommandPayloadTypeFor
  }
  extends DeclaredRelationshipType.RelationshipType
  source CommandType.HolonType
  target HolonType.TypeDescriptor
  deletion_semantic Block
  header {
    description: "Links a CommandType to the holon type carried as its command payload."
    display_name: "CommandPayloadType Relationship"
