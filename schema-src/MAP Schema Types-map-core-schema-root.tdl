schema MAP Core Schema-v0.0.7 {
  depends_on MAP Key Rule Schema
  depends_on MAP Dance Schema-v0.0.4
  depends_on MAP Query Schema-v0.0.1
  header {
    description: "Schema containing the root descriptor-type and meta-type definitions for the MAP Type System."
  }
}

abstract holon TypeDescriptor {
  keyrule TypeNameRule.KeyRuleType
  header {
    description: "Abstract root of the descriptor-type hierarchy. It classifies descriptor types and serves as a polymorphic target for schema components and other descriptor-oriented relationships. It is not the generic describing type for descriptor holons."
    display_name: "Type Descriptor"
    display_plural: "Type Descriptors"
    plural: "TypeDescriptors"
  }
}


abstract holon HolonType {
  keyrule ExtendedTypeRule.KeyRuleType
  extends TypeDescriptor
  header {
    description: "Abstract root for descriptor types whose described instances are holons. Concrete holon type descriptors extend this type to classify their instances and inherit the baseline holon instance contract."
    display_name: "Abstract Holon Type"
    display_plural: "Abstract Holon Types"
    plural: "HolonTypes"
  }
  relationships {
    InstanceRelationships -> [
      (HolonType)-[DescribedBy]->(TypeDescriptor),
      (HolonType)-[OwnedBy]->(HolonSpace.HolonType),
      (HolonType)-[AffordsCommand]->(CommandType.HolonType),
      (HolonType)-[Predecessor]->(HolonType),
      (HolonType)-[AffordsDance]->(DanceType.HolonType)
    ]
    AffordsCommand -> [
      CloneHolon.CommandType,
      Summarize.CommandType,
      GetHolonId.CommandType,
      GetPredecessor.CommandType,
      GetKey.CommandType,
      GetVersionedKey.CommandType,
      GetPropertyValue.CommandType,
      GetRelatedHolons.CommandType,
      WithPropertyValue.CommandType,
      RemovePropertyValue.CommandType,
      AddRelatedHolons.CommandType,
      RemoveRelatedHolons.CommandType,
      WithDescriptor.CommandType
    ]
  }
}


abstract holon PropertyType {
  keyrule ExtendedTypeRule.KeyRuleType
  extends TypeDescriptor
  header {
    description: "Abstract root for descriptor types that define scalar or structured property members."
    display_name: "Abstract Property Type"
    display_plural: "Abstract Property Types"
    plural: "PropertyTypes"
  }
}


abstract holon DeclaredRelationshipType {
  keyrule RelationshipRule.KeyRuleType
  extends TypeDescriptor
  header {
    description: "Abstract root for explicitly declared relationship descriptor types."
    display_name: "Declared Relationship Type"
    display_plural: "Declared Relationship Types"
    plural: "DeclaredRelationshipTypes"
  }
}


abstract holon InverseRelationshipType {
  keyrule RelationshipRule.KeyRuleType
  extends TypeDescriptor
  header {
    description: "Abstract root for inverse relationship descriptor types derived from declared relationships."
    display_name: "Inverse Relationship Type"
    display_plural: "Inverse Relationship Types"
    plural: "InverseRelationshipTypes"
  }
}


abstract holon MetaTypeDescriptor {
  keyrule TypeNameRule.KeyRuleType
  header {
    description: "Root of the meta-type hierarchy. It defines the common self-conformance contract shared by type-descriptor holons."
    display_name: "Meta Type Descriptor"
    display_plural: "Meta Type Descriptors"
    plural: "MetaTypeDescriptors"
  }
  relationships {
    InstanceProperties -> [
      TypeName.PropertyType,
      TypeNamePlural.PropertyType,
      DisplayName.PropertyType,
      DisplayNamePlural.PropertyType,
      Description.PropertyType,
      IsAbstractType.PropertyType,
      TypeKind.PropertyType,
      SchemaName.PropertyType
    ]
    InstanceRelationships -> [
      (TypeDescriptor)-[ComponentOf]->(Schema),
      (TypeDescriptor)-[Extends]->(TypeDescriptor),
      (TypeDescriptor)-[UsesKeyRule]->(KeyRuleType)
    ]
  }
}

InstanceRelationships -> [
  (HolonType)-[DescribedBy]->(TypeDescriptor),
  (HolonType)-[OwnedBy]->(HolonSpace.HolonType),
  (HolonType)-[AffordsCommand]->(CommandType.HolonType),
  (TypeDescriptor)-[InstanceProperties]->(PropertyType),
  (MetaHolonType)-[InstanceRelationships]->(DeclaredRelationshipType),
  (HolonType)-[Predecessor]->(HolonType),
  (HolonType)-[AffordsDance]->(DanceType.HolonType)
]


holon MetaPropertyType {
  extends MetaTypeDescriptor
  header {
    description: "Meta-type describing property-type descriptor holons."
    display_name: "Meta Property Type"
    display_plural: "Meta Property Types"
    plural: "MetaPropertyTypes"
  }
  relationships {
    InstanceProperties -> [
      IsValueRequired.PropertyType,
      DefaultValue.PropertyType,
      InheritanceMode.PropertyType
    ]
    InstanceRelationships -> [
      (PropertyType)-[ValueType]->(ValueType)
    ]
  }
}


holon MetaRelationshipType {
  extends MetaTypeDescriptor
  header {
    description: "Meta-type describing relationship descriptor holons."
    display_name: "Meta Relationship Type"
    display_plural: "Meta Relationship Types"
    plural: "MetaRelationshipTypes"
  }
  relationships {
    InstanceProperties -> [
      IsDefinitional.PropertyType,
      IsOrdered.PropertyType,
      AllowsDuplicates.PropertyType,
      MinCardinality.PropertyType,
      MaxCardinality.PropertyType,
      DeletionSemantic.PropertyType,
      InheritanceMode.PropertyType
    ]
    InstanceRelationships -> [
      (MetaRelationshipType)-[SourceType]->(TypeDescriptor),
      (MetaRelationshipType)-[TargetType]->(TypeDescriptor)
    ]
  }
}


holon MetaDeclaredRelationshipType {
  extends MetaRelationshipType
  header {
    description: "Meta-type describing explicitly declared relationship descriptor holons."
    display_name: "Meta Declared Relationship Type"
    display_plural: "Meta Declared Relationship Types"
    plural: "MetaDeclaredRelationshipTypes"
  }
  relationships {
    InstanceRelationships -> [
      (DeclaredRelationshipType)-[HasInverse]->(InverseRelationshipType)
    ]
  }
}

holon MetaInverseRelationshipType {
  extends MetaRelationshipType
  header {
    description: "Meta-type describing inverse relationship descriptor holons."
    display_name: "Meta Inverse Relationship Type"
    display_plural: "Meta Inverse Relationship Types"
    plural: "MetaInverseRelationshipTypes"
  }
  relationships {
    InstanceProperties -> [
      InheritanceMode.PropertyType
    ]
  }
}

holon Schema {
  keyrule SchemaNameRule.KeyRuleType
  extends HolonType
  header {
    description: "Describes schema holons that anchor a cohesive schema and declare inter-schema dependencies."
    display_name: "Schema"
    display_plural: "Schemas"
    plural: "Schemas"
  }
  relationships {
    InstanceProperties -> [
      Description.PropertyType,
      SchemaName.PropertyType
    ]
    InstanceRelationships -> [
      (Schema.HolonType)-[DependsOn]->(Schema.HolonType)
    ]
  }
}


holon HolonSpace {
  extends HolonType
  header {
    description: "Describes holon spaces as containers for holons and as the boundary that affords transaction and query services over a cohesive schema scope."
    display_name: "Holon Space"
    display_plural: "Holon Spaces"
    plural: "HolonSpaces"
  }
  relationships {
    InstanceRelationships -> [
      (HolonSpace.HolonType)-[AffordsTransactionModel]->(Transaction.HolonType)
    ]
    AffordsCommand -> BeginTransaction.CommandType
    AffordsDance -> QueryDance.DanceType
    AffordsTransactionModel -> Transaction.HolonType
  }
}


holon HolonError {
  extends HolonType
  header {
    description: "Describes the structure of error holons."
    display_name: "Holon Error"
    display_plural: "Holon Errors"
    plural: "HolonErrors"
  }
  relationships {
    InstanceProperties -> [
      ErrorType.PropertyType,
      ErrorMessage.PropertyType
    ]
  }
}


holon Transaction {
  extends HolonType
  header {
    description: "Descriptor for the MAP transaction model: the command-scope holon surface available while a transaction is active."
    display_name: "Transaction"
    display_plural: "Transactions"
    plural: "Transactions"
  }
  relationships {
    AffordsCommand -> [
      Commit.CommandType,
      UndoLast.CommandType,
      RedoLast.CommandType,
      UndoToMarker.CommandType,
      RedoToMarker.CommandType,
      LoadHolons.CommandType,
      Dance.CommandType,
      GetAllHolons.CommandType,
      GetStagedHolonByBaseKey.CommandType,
      GetStagedHolonsByBaseKey.CommandType,
      GetStagedHolonByVersionedKey.CommandType,
      GetTransientHolonByBaseKey.CommandType,
      GetTransientHolonByVersionedKey.CommandType,
      GetStagedCount.CommandType,
      GetTransientCount.CommandType,
      NewHolon.CommandType,
      StageNewHolon.CommandType,
      StageNewFromClone.CommandType,
      StageNewVersion.CommandType,
      StageNewVersionFromId.CommandType,
      DeleteHolon.CommandType
    ]
  }
}


holon HolonCollection {
  extends HolonType
  header {
    description: "Concrete collection type descriptor for persisted collection holons."
    display_name: "Holon Collection"
    display_plural: "Holon Collections"
    plural: "HolonCollections"
  }
  relationships {
    InstanceProperties -> [
      CollectionType.PropertyType,
      IsOrdered.PropertyType,
      AllowsDuplicates.PropertyType
    ]
    InstanceRelationships -> [
      (HolonCollection.HolonType)-[CollectionMembers]->(HolonType),
      (HolonCollection.HolonType)-[ElementType]->(HolonType)
    ]
  }
}