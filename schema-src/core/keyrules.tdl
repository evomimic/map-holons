schema "MAP Core Schema-v0.0.7" {
  header {
    description: "Groups all type descriptors related to holon key derivation strategies in MAP."
  }
}

abstract holon KeyRuleType.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends Rule.HolonType
  header {
    description: "Abstract holon type for key-rule strategies that derive semantic keys for holons. Concrete key-rule types define the available derivation algorithms."
    display_name: "Abstract Key Rule Type"
    display_plural: "Abstract Key Rule Types"
    plural: "KeyRuleTypes"
  }
}

holon FormatRule.KeyRuleType {
  type MetaHolonType.MetaTypeDescriptor
  instance_keyrule DescribedTypeRule.KeyRuleType
  extends KeyRuleType.HolonType
  header {
    description: "Concrete key-rule type for named, reusable format configurations composed from a template string and an ordered list of property descriptors."
    display_name: "Format Key Rule Type"
    display_plural: "Format Key Rule Types"
    plural: "FormatRules"
  }
  relationships {
    InstanceProperties -> [
      TypeName.PropertyType,
      TemplateString.PropertyType
    ]
    InstanceRelationships -> [
      (FormatRule.KeyRuleType)-[TemplateParameters]->(PropertyType.TypeDescriptor)
    ]
  }
}

instance HolonSpaceNameRule.FormatRule {
  type FormatRule.KeyRuleType
  rule_of "MAP Core Schema-v0.0.7"
  TypeName "HolonSpaceNameRule"
  TemplateString "$0"
  relationships {
    TemplateParameters -> HolonSpaceName.PropertyType
  }
}

holon EnumVariantRule.KeyRuleType {
  type MetaHolonType.MetaTypeDescriptor
  extends KeyRuleType.HolonType
  header {
    description: "For enum-variant descriptors, derives keys as {EnumName}.{VariantName}, for example DeletionSemantic.Allow."
