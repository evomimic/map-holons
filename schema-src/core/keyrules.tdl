def relationship (HolonType.TypeDescriptor)-[InstanceKeyRule]->(KeyRuleType.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
    HasInverse -> KeyRuleForInstancesOf
  }
  extends DeclaredRelationshipType.RelationshipType
  source HolonType.TypeDescriptor
  target KeyRuleType.HolonType
  deletion_semantic Allow
  header {
    description: "Selects the key rule governing holons described by a holon type. The rule does not govern the key of the source type descriptor itself."
    display_name: "Instance Key Rule"
    display_plural: "Instance Key Rule Relationships"
    plural: "InstanceKeyRuleRelationships"
  }
}

inverse relationship (KeyRuleType.HolonType)-[KeyRuleForInstancesOf]->(HolonType.TypeDescriptor) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source KeyRuleType.HolonType
  target HolonType.TypeDescriptor
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of InstanceKeyRule, from a key rule to the holon types whose described instances use it."
    display_name: "Key Rule For Instances Of"
    display_plural: "Key Rule For Instances Of Relationships"
    plural: "KeyRuleForInstancesOfRelationships"
  }
}
