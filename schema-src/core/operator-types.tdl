}

def relationship (OperatorType.HolonType)-[OperandSpecifications]->(OperandSpecification.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
    HasInverse -> OperandSpecificationsForOperators
  }
  extends DeclaredRelationshipType.RelationshipType
  source OperatorType.HolonType
  target OperandSpecification.HolonType
  ordered
  deletion_semantic Block
  header {
    description: "Ordered specifications of an operator's authored operands; relationship position defines each operand's position after the subject. The count must equal Arity minus one."
