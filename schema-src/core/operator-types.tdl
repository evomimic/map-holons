holon ContainsOperator.OperatorType {
  type MetaOperatorType.MetaHolonType
  extends OperatorType.HolonType
  Arity 2
  OperatorCategory Matching
  CaseMatching UnicodeDefaultCaseFold
  header {
    description: "Returns true iff the subject string contains the authored substring under the operator's case-matching policy. The substring is literal text, never a pattern; an empty substring matches every present string."
    display_name: "Contains"
    display_plural: "Contains Operators"
    plural: "ContainsOperators"
  }
  relationships {
    OperandSpecifications -> ContainsSubstring.OperandSpecification
