}

instance LessThanComparisonValue.OperandSpecification {
  type OperandSpecification.HolonType
  OperandRole "ComparisonValue"
  DisplayName "Comparison Value"
  Description "Value the subject must be ordered before."
  OperandValueTypeRule SameAsSubject
}

instance ContainsSubstring.OperandSpecification {
  type OperandSpecification.HolonType
  OperandRole "Substring"
  DisplayName "Substring"
  Description "Literal text the subject must contain. It need not satisfy the subject's specialized constraints."
  OperandValueTypeRule FixedValueType
  relationships {
    OperandValueType -> MapStringValueType.StringValueType
  }
}

