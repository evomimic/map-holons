schema "MAP Theme Schema-v0.1.3" {
  depends_on "MAP Core Schema-v0.0.10"
  depends_on "MAP Dance Schema-v0.1.3"
  depends_on "MAP Design Tokens Schema-v0.1.3"
  depends_on "MAP Meta Design System Schema-v0.1.3"
  header {
    description: "MAP schema for Themes as complete, typed value assignments for one Meta Design System. Theme availability is independent of Dancer identity."
  }
}

meta {
  schema_key: "MAP Theme Schema-v0.1.3"
}

// Realizes the same complete token contract as the other Demo 1 themes.
instance Demo1.ForestSanctuaryTheme {
  type Theme.HolonType
  ThemeName "Demo 1 — Forest Sanctuary"
  ThemeDescription "A welcoming woodland theme inspired by a sunlit garden entrance. Deep forest canvas surfaces frame moss-green panels and collections, warm ivory text, muted sage secondary text, and gold focus and activity accents. Fern-green actions, quiet borders, modest corner rounding, generous spacing, and serif headings paired with system sans-serif body text bring the garden palette to the shared Demo 1 design-token contract."
  relationships {
    ForMetaDesignSystem -> Demo1.MetaDesignSystem
    HasThemeTokenAssignment -> [
      Demo1.ForestSanctuaryTheme.CollectionNavigationSurfaceBackground.ThemeTokenAssignment,
      Demo1.ForestSanctuaryTheme.CollectionNavigationTextColor.ThemeTokenAssignment,
      Demo1.ForestSanctuaryTheme.RelationshipNavigationSurfaceBackground.ThemeTokenAssignment,
      Demo1.ForestSanctuaryTheme.RelationshipNavigationTextColor.ThemeTokenAssignment,
      Demo1.ForestSanctuaryTheme.ViewControlSurfaceBackground.ThemeTokenAssignment,
      Demo1.ForestSanctuaryTheme.ViewControlTextColor.ThemeTokenAssignment,
      Demo1.ForestSanctuaryThemePanelSurfaceBackground,
      Demo1.ForestSanctuaryThemePanelCornerRadius,
      Demo1.ForestSanctuaryThemeMutedTextColor,
      Demo1.ForestSanctuaryThemeNodeHeadingFontSize,
      Demo1.ForestSanctuaryThemeControlGap,
      Demo1.ForestSanctuaryThemeFocusRingColor,
      Demo1.ForestSanctuaryThemeFocusRingWidth,

      Demo1.ForestSanctuaryThemeLauncherSurfaceBackground,
      Demo1.ForestSanctuaryThemeLauncherTextColor,
      Demo1.ForestSanctuaryThemeLauncherPadding,
      Demo1.ForestSanctuaryThemeLauncherPhaseGap,
      Demo1.ForestSanctuaryThemeLauncherIndicatorSize,
      Demo1.ForestSanctuaryThemeLauncherIndicatorColor,
      Demo1.ForestSanctuaryThemeLauncherIndicatorWidth,
      Demo1.ForestSanctuaryThemeLauncherIndicatorDuration,
      Demo1.ForestSanctuaryThemeLauncherDismissDuration,
      Demo1.ForestSanctuaryThemeActionSurfaceBackground,
      Demo1.ForestSanctuaryThemeActionHoverSurfaceBackground,
      Demo1.ForestSanctuaryThemeActionTextColor,
      Demo1.ForestSanctuaryThemeActionPaddingBlock,
      Demo1.ForestSanctuaryThemeActionPaddingInline,
      Demo1.ForestSanctuaryThemeActionCornerRadius,

      Demo1.ForestSanctuaryThemeCanvasFontFamily,
      Demo1.ForestSanctuaryThemeCanvasHeadingFontFamily,
      Demo1.ForestSanctuaryThemeCanvasFontSize,
      Demo1.ForestSanctuaryThemeCanvasFontWeight,
      Demo1.ForestSanctuaryThemeCanvasLineHeight,
      Demo1.ForestSanctuaryThemeCanvasHeadingFontWeight,
      Demo1.ForestSanctuaryThemeCanvasContentMinHeight,
      Demo1.ForestSanctuaryThemePropertiesDisclosureFocusColor,
      Demo1.ForestSanctuaryThemeSlotBorderColor,
      Demo1.ForestSanctuaryThemeSlotBorderWidth,
      Demo1.ForestSanctuaryThemeSlotBorderStyle,
      Demo1.ForestSanctuaryThemeSlotPadding,
      Demo1.ForestSanctuaryThemeInspectorRailWidth,
      Demo1.ForestSanctuaryThemeInspectorContentMinHeight,
      Demo1.ForestSanctuaryThemePropertiesHeadingGap,
      Demo1.ForestSanctuaryThemePropertiesRowGap,
      Demo1.ForestSanctuaryThemePropertiesHeadingFontSize,
      Demo1.ForestSanctuaryThemePropertiesHeadingFontWeight,
      Demo1.ForestSanctuaryThemePropertyColumnGap,
      Demo1.ForestSanctuaryThemePropertyNameMinWidth,
      Demo1.ForestSanctuaryThemeTableCellBorderStyle,
      Demo1.ForestSanctuaryThemeCollectionHeadingFontSize,
      Demo1.ForestSanctuaryThemeCollectionHeadingFontWeight,
      Demo1.ForestSanctuaryThemeTableHeaderFontWeight,

      Demo1.ForestSanctuaryThemeCanvasGap,
      Demo1.ForestSanctuaryThemeCanvasPadding,
      Demo1.ForestSanctuaryThemeCanvasSurfaceBackground,
      Demo1.ForestSanctuaryThemeCanvasTextColor,
      Demo1.ForestSanctuaryThemeCollectionSurfaceBackground,
      Demo1.ForestSanctuaryThemeCollectionTextColor,
      Demo1.ForestSanctuaryThemeCollectionHeaderSurfaceBackground,
      Demo1.ForestSanctuaryThemeTableHeaderSurfaceBackground,
      Demo1.ForestSanctuaryThemeTableHeaderTextColor,
      Demo1.ForestSanctuaryThemeTableCellBorderColor,
      Demo1.ForestSanctuaryThemeTableCellBorderWidth,
      Demo1.ForestSanctuaryThemeTableCellPadding
    ]
    OfferedByHolonSpace -> MAP.CoreSchemaSpace
  }
}

