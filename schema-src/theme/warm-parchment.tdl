schema "MAP Theme Schema-v0.1.4" {
  depends_on "MAP Core Schema-v0.0.12"
  depends_on "MAP Dance Schema-v0.1.4"
  depends_on "MAP Design Tokens Schema-v0.1.4"
  depends_on "MAP Meta Design System Schema-v0.1.4"
  header {
    description: "MAP schema for Themes as complete, typed value assignments for one Meta Design System. Theme availability is independent of Dancer identity."
  }
}

meta {
  schema_key: "MAP Theme Schema-v0.1.4"
}

// Theme identity is independent of how the Theme is loaded.
// Handwritten font faces resolve locally; systems without them use the sans-serif fallback.
instance Demo1.WarmParchmentTheme {
  type Theme.HolonType
  ThemeName "Demo 1 — Warm Parchment"
  ThemeDescription "A warm, handcrafted demonstration theme for DAHN. Walnut canvas surfaces frame warm umber panels and pale parchment collections, with caramel collection headers, dark cocoa table headers, and chestnut action controls. Beige text and amber focus accents complement the browns. Legible handwritten-style system fonts, generous line spacing, and restrained but distinct borders support comfortable reading. Beige collection tabs and relationship rail buttons, muted taupe view controls, and chestnut holon actions distinguish navigation from operations."
  relationships {
    ForMetaDesignSystem -> Demo1.MetaDesignSystem
    HasThemeTokenAssignment -> [
      Demo1.WarmParchmentTheme.CollectionNavigationSurfaceBackground.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.CollectionNavigationTextColor.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.RelationshipNavigationSurfaceBackground.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.RelationshipNavigationTextColor.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.ViewControlSurfaceBackground.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.ViewControlTextColor.ThemeTokenAssignment,
      Demo1.WarmParchmentThemePanelSurfaceBackground,
      Demo1.WarmParchmentThemePanelCornerRadius,
      Demo1.WarmParchmentThemeMutedTextColor,
      Demo1.WarmParchmentThemeNodeHeadingFontSize,
      Demo1.WarmParchmentThemeControlGap,
      Demo1.WarmParchmentThemeFocusRingColor,
      Demo1.WarmParchmentThemeFocusRingWidth,

      Demo1.WarmParchmentThemeLauncherSurfaceBackground,
      Demo1.WarmParchmentThemeLauncherTextColor,
      Demo1.WarmParchmentThemeLauncherPadding,
      Demo1.WarmParchmentThemeLauncherPhaseGap,
      Demo1.WarmParchmentThemeLauncherIndicatorSize,
      Demo1.WarmParchmentThemeLauncherIndicatorColor,
      Demo1.WarmParchmentThemeLauncherIndicatorWidth,
      Demo1.WarmParchmentThemeLauncherIndicatorDuration,
      Demo1.WarmParchmentThemeLauncherDismissDuration,
      Demo1.WarmParchmentThemeActionSurfaceBackground,
      Demo1.WarmParchmentThemeActionHoverSurfaceBackground,
      Demo1.WarmParchmentThemeActionTextColor,
      Demo1.WarmParchmentThemeActionPaddingBlock,
      Demo1.WarmParchmentThemeActionPaddingInline,
      Demo1.WarmParchmentThemeActionCornerRadius,

      Demo1.WarmParchmentThemeCanvasFontFamily,
      Demo1.WarmParchmentThemeCanvasHeadingFontFamily,
      Demo1.WarmParchmentThemeCanvasFontSize,
      Demo1.WarmParchmentThemeCanvasFontWeight,
      Demo1.WarmParchmentThemeCanvasLineHeight,
      Demo1.WarmParchmentThemeCanvasHeadingFontWeight,
      Demo1.WarmParchmentThemeCanvasContentMinHeight,
      Demo1.WarmParchmentThemePropertiesDisclosureFocusColor,
      Demo1.WarmParchmentThemeSlotBorderColor,
      Demo1.WarmParchmentThemeSlotBorderWidth,
      Demo1.WarmParchmentThemeSlotBorderStyle,
      Demo1.WarmParchmentThemeSlotPadding,
      Demo1.WarmParchmentThemeInspectorRailWidth,
      Demo1.WarmParchmentThemeInspectorContentMinHeight,
      Demo1.WarmParchmentThemePropertiesHeadingGap,
      Demo1.WarmParchmentThemePropertiesRowGap,
      Demo1.WarmParchmentThemePropertiesHeadingFontSize,
      Demo1.WarmParchmentThemePropertiesHeadingFontWeight,
      Demo1.WarmParchmentThemePropertyColumnGap,
      Demo1.WarmParchmentThemePropertyNameMinWidth,
      Demo1.WarmParchmentThemeTableCellBorderStyle,
      Demo1.WarmParchmentThemeCollectionHeadingFontSize,
      Demo1.WarmParchmentThemeCollectionHeadingFontWeight,
      Demo1.WarmParchmentThemeTableHeaderFontWeight,

      Demo1.WarmParchmentThemeCanvasGap,
      Demo1.WarmParchmentThemeCanvasPadding,
      Demo1.WarmParchmentThemeCanvasSurfaceBackground,
      Demo1.WarmParchmentThemeCanvasTextColor,
      Demo1.WarmParchmentThemeCollectionSurfaceBackground,
      Demo1.WarmParchmentThemeCollectionTextColor,
      Demo1.WarmParchmentThemeCollectionHeaderSurfaceBackground,
      Demo1.WarmParchmentThemeTableHeaderSurfaceBackground,
      Demo1.WarmParchmentThemeTableHeaderTextColor,
      Demo1.WarmParchmentThemeTableCellBorderColor,
      Demo1.WarmParchmentThemeTableCellBorderWidth,
      Demo1.WarmParchmentThemeTableCellPadding
    ]
    OfferedByHolonSpace -> MAP.CoreSchemaSpace
  }
}

