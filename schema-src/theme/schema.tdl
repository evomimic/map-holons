      Demo1.WarmParchmentThemeNodeHeadingFontSize,
      Demo1.WarmParchmentThemeControlGap,
      Demo1.WarmParchmentThemeFocusRingColor,
      Demo1.WarmParchmentThemeFocusRingWidth,

      Demo1.WarmParchmentThemeLauncherSurfaceBackground,
      Demo1.WarmParchmentThemeLauncherTextColor,
      Demo1.WarmParchmentThemeLauncherPadding,
      Demo1.WarmParchmentThemeLauncherPhaseGap,
      Demo1.WarmParchmentThemeLauncherIndicatorSize,
      Demo1.WarmParchmentThemeLauncherIndicatorColor,
      Demo1.WarmParchmentThemeLauncherIndicatorWidth,
      Demo1.WarmParchmentThemeLauncherIndicatorDuration,
      Demo1.WarmParchmentThemeLauncherDismissDuration,
      Demo1.WarmParchmentThemeActionSurfaceBackground,
      Demo1.WarmParchmentThemeActionHoverSurfaceBackground,
      Demo1.WarmParchmentThemeActionTextColor,
      Demo1.WarmParchmentThemeActionPaddingBlock,
      Demo1.WarmParchmentThemeActionPaddingInline,
