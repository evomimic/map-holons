property ThemeDescription.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  IsValueRequired true
  header {
    description: "Human-readable purpose and visual character of a Theme."
    display_name: "theme_description"
    display_plural: "theme_descriptions"
    plural: "ThemeDescriptions"
  }
}

// Handwritten font faces resolve locally; systems without them use the sans-serif fallback.
instance Demo1.WarmParchmentTheme {
  type Theme.HolonType
  ThemeName "Demo 1 — Warm Parchment"
  ThemeDescription "A warm, handcrafted demonstration theme for DAHN. Walnut canvas surfaces frame warm umber panels and pale parchment collections, with caramel collection headers, dark cocoa table headers, and chestnut action controls. Beige text and amber focus accents complement the browns. Legible handwritten-style system fonts, generous line spacing, and restrained but distinct borders support comfortable reading. Beige collection tabs and relationship rail buttons, muted taupe view controls, and chestnut holon actions distinguish navigation from operations."
  relationships {
    ForMetaDesignSystem -> Demo1.MetaDesignSystem
    HasThemeTokenAssignment -> [
      Demo1.WarmParchmentTheme.CollectionNavigationSurfaceBackground.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.CollectionNavigationTextColor.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.RelationshipNavigationSurfaceBackground.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.RelationshipNavigationTextColor.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.ViewControlSurfaceBackground.ThemeTokenAssignment,
      Demo1.WarmParchmentTheme.ViewControlTextColor.ThemeTokenAssignment,
