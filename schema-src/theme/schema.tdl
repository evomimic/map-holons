schema "MAP Theme Schema-v0.1.0" {
  depends_on "MAP Core Schema-v0.0.7"
  depends_on "MAP Design Tokens Schema-v0.1.0"
  depends_on "MAP Meta Design System Schema-v0.1.0"
  header {
    description: "MAP schema for Themes as complete, typed value assignments for one Meta Design System. Theme availability is independent of Dancer identity."
  }
}

holon Theme.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "A user-selectable, complete realization of one MetaDesignSystem's DesignToken vocabulary. It assigns concrete typed presentation values through ThemeTokenAssignments for every DesignToken the MetaDesignSystem defines, allowing a runtime to project the Theme once to CSS. Theme selection is person- and space-driven, independent of Dancer or application choice. The notion of a theme and token-value assignment is common design-system practice, but Theme and its relationship semantics are MAP-native rather than DTCG-standardized."
    display_name: "Theme"
    display_plural: "Themes"
    plural: "Themes"
  }
  relationships {
    InstanceProperties -> [
      ThemeName.PropertyType,
      ThemeDescription.PropertyType
    ]
    InstanceRelationships -> [
      (Theme.HolonType)-[ForMetaDesignSystem]->(MetaDesignSystem.HolonType),
      (Theme.HolonType)-[HasThemeTokenAssignment]->(ThemeTokenAssignment.HolonType),
      (Theme.HolonType)-[OfferedByHolonSpace]->(HolonSpace.HolonType)
    ]
  }
}

holon ThemeTokenAssignment.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  instance_keyrule ThemeTokenAssignmentPairRule.RelationshipPairRule
  extends HolonType.TypeDescriptor
  header {
    description: "A MAP-native intersection holon binding one Theme to one DesignToken and the concrete presentation value supplied for it. The ordered (Theme, DesignToken) pair is its semantic key, making one assignment per token explicit and validating complete Theme coverage. Its value is constrained by a DTCG-aligned DesignTokenType, but this holon and its graph representation do not imply DTCG serialization."
    display_name: "Theme Token Assignment"
    display_plural: "Theme Token Assignments"
    plural: "ThemeTokenAssignments"
  }
  relationships {
    InstanceProperties -> PresentationValue.PropertyType
    InstanceRelationships -> (ThemeTokenAssignment.HolonType)-[ForDesignToken]->(DesignToken.HolonType)
  }
}

holon RelationshipPairRule.KeyRuleType {
  type MetaHolonType.MetaTypeDescriptor
  extends KeyRuleType.HolonType
  header {
    description: "A MAP-specific key-rule strategy for intersection holons whose semantic identity is an ordered pair of relationship targets. It gives such a holon a stable derived identity without requiring an independently authored identifier. It has no DTCG counterpart."
    display_name: "Relationship Pair Key Rule"
    display_plural: "Relationship Pair Key Rules"
    plural: "RelationshipPairRules"
  }
}

instance ThemeTokenAssignmentPairRule.RelationshipPairRule {
  type RelationshipPairRule.KeyRuleType
  rule_of "MAP Theme Schema-v0.1.0"
}

property ThemeName.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  IsValueRequired true
  header {
    description: "Stable semantic name of a Theme."
    display_name: "theme_name"
    display_plural: "theme_names"
    plural: "ThemeNames"
  }
}

property PresentationValue.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  IsValueRequired true
  header {
    description: "String-backed value supplied by a ThemeTokenAssignment. It must conform to the assigned DesignToken's DesignTokenType."
    display_name: "presentation_value"
    display_plural: "presentation_values"
    plural: "PresentationValues"
  }
}

relationship (Theme.HolonType)-[ForMetaDesignSystem]->(MetaDesignSystem.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
    HasInverse -> HasTheme
  }
  extends DeclaredRelationshipType.RelationshipType
  source Theme.HolonType
  target MetaDesignSystem.HolonType
  deletion_semantic Allow
  header {
    description: "Records the one MetaDesignSystem whose complete DesignToken contract a Theme realizes."
    display_name: "For Meta Design System"
    display_plural: "For Meta Design System Relationships"
    plural: "ForMetaDesignSystemRelationships"
  }
}

inverse relationship (MetaDesignSystem.HolonType)-[HasTheme]->(Theme.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source MetaDesignSystem.HolonType
  target Theme.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of ForMetaDesignSystem."
    display_name: "Has Theme"
    display_plural: "Has Theme Relationships"
    plural: "HasThemeRelationships"
  }
}

relationship (Theme.HolonType)-[HasThemeTokenAssignment]->(ThemeTokenAssignment.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> OneOrMore.CardinalityConstraint
    HasInverse -> AssignedForTheme
  }
  extends DeclaredRelationshipType.RelationshipType
  source Theme.HolonType
  target ThemeTokenAssignment.HolonType
  deletion_semantic Allow
  header {
    description: "Defines what Design Tokens implementers of this Theme need to assign values for."
    display_name: "Has Theme Token Assignment"
    display_plural: "Has Theme Token Assignment Relationships"
    plural: "HasThemeTokenAssignmentRelationships"
  }
}

inverse relationship (ThemeTokenAssignment.HolonType)-[AssignedForTheme]->(Theme.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source ThemeTokenAssignment.HolonType
  target Theme.HolonType
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of HasThemeTokenAssignment. Each assignment belongs to exactly one Theme."
    display_name: "Assigned For Theme"
    display_plural: "Assigned For Theme Relationships"
    plural: "AssignedForThemeRelationships"
  }
}

def relationship (ThemeTokenAssignment.HolonType)-[ForDesignToken]->(DesignToken.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
    HasInverse -> HasThemeTokenAssignmentFor
  }
  extends DeclaredRelationshipType.RelationshipType
  source ThemeTokenAssignment.HolonType
  target DesignToken.HolonType
  deletion_semantic Allow
  header {
    description: "Identifies the DesignToken whose value is supplied by one ThemeTokenAssignment."
    display_name: "For Design Token"
    display_plural: "For Design Token Relationships"
    plural: "ForDesignTokenRelationships"
  }
}

inverse relationship (DesignToken.HolonType)-[HasThemeTokenAssignmentFor]->(ThemeTokenAssignment.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source DesignToken.HolonType
  target ThemeTokenAssignment.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of ForDesignToken."
    display_name: "Has Theme Token Assignment For"
    display_plural: "Has Theme Token Assignment For Relationships"
    plural: "HasThemeTokenAssignmentForRelationships"
  }
}

relationship (Theme.HolonType)-[OfferedByHolonSpace]->(HolonSpace.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
    HasInverse -> OffersTheme
  }
  extends DeclaredRelationshipType.RelationshipType
  source Theme.HolonType
  target HolonSpace.HolonType
  deletion_semantic Allow
  header {
    description: "Associates a Theme with a HolonSpace that offers it for user selection without binding the Theme to any Dancer."
    display_name: "Offered By Holon Space"
    display_plural: "Offered By Holon Space Relationships"
    plural: "OfferedByHolonSpaceRelationships"
  }
}

inverse relationship (HolonSpace.HolonType)-[OffersTheme]->(Theme.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source HolonSpace.HolonType
  target Theme.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of OfferedByHolonSpace, exposing Themes offered by a HolonSpace."
    display_name: "Offers Theme"
    display_plural: "Offers Theme Relationships"
    plural: "OffersThemeRelationships"
  }
}

instance ThemeTokenAssignmentPairUniqueness.ValidationRule {
  type HolonValidationRule.HolonType
  ValidationLevel Holon
  DeterminismClass Deterministic
  SemanticAuthority "THEME-001"
  ValidationRuleDescription "A Theme may have exactly one ThemeTokenAssignment for each DesignToken."
  rule_of "MAP Theme Schema-v0.1.0"
}

instance ThemeTokenAssignmentDesignTokenType.ValidationRule {
  type HolonValidationRule.HolonType
  ValidationLevel Holon
  DeterminismClass Deterministic
  SemanticAuthority "THEME-002"
  ValidationRuleDescription "A ThemeTokenAssignment PresentationValue must conform to its DesignToken's DesignTokenType."
  rule_of "MAP Theme Schema-v0.1.0"
}

instance ThemeCompleteDesignTokenCoverage.ValidationRule {
  type HolonValidationRule.HolonType
  ValidationLevel Holon
  DeterminismClass Deterministic
  SemanticAuthority "THEME-003"
  ValidationRuleDescription "A Theme must assign exactly one value to every DesignToken defined by its ForMetaDesignSystem target."
  rule_of "MAP Theme Schema-v0.1.0"
}

// Demonstration identity is independent of how the Theme is loaded.
// Other demonstration themes may realize the same MetaDesignSystem contract.
instance Demo1.DeepOceanTheme {
  type Theme.HolonType
  ThemeName "Demo 1 — Deep Ocean"
  ThemeDescription "A demonstration theme for exploring DAHN features. Deep Ocean is calm, orderly, and utilitarian, with limited visual differentiation between kinds of controls. Layered navy surfaces, muted teal actions, seafoam focus accents, softly rounded corners, and system sans-serif typography provide a consistent setting for feature demonstrations rather than an optimized human experience."
  relationships {
    ForMetaDesignSystem -> Demo1.MetaDesignSystem
    HasThemeTokenAssignment -> [
      Demo1.DeepOceanTheme.CollectionNavigationSurfaceBackground.ThemeTokenAssignment,
      Demo1.DeepOceanTheme.CollectionNavigationTextColor.ThemeTokenAssignment,
      Demo1.DeepOceanTheme.RelationshipNavigationSurfaceBackground.ThemeTokenAssignment,
      Demo1.DeepOceanTheme.RelationshipNavigationTextColor.ThemeTokenAssignment,
      Demo1.DeepOceanTheme.ViewControlSurfaceBackground.ThemeTokenAssignment,
      Demo1.DeepOceanTheme.ViewControlTextColor.ThemeTokenAssignment,
      Demo1.DeepOceanThemePanelSurfaceBackground,
      Demo1.DeepOceanThemePanelCornerRadius,
      Demo1.DeepOceanThemeMutedTextColor,
      Demo1.DeepOceanThemeNodeHeadingFontSize,
      Demo1.DeepOceanThemeControlGap,
      Demo1.DeepOceanThemeFocusRingColor,
      Demo1.DeepOceanThemeFocusRingWidth,

      Demo1.DeepOceanThemeLauncherSurfaceBackground,
      Demo1.DeepOceanThemeLauncherTextColor,
      Demo1.DeepOceanThemeLauncherPadding,
      Demo1.DeepOceanThemeLauncherPhaseGap,
      Demo1.DeepOceanThemeLauncherIndicatorSize,
      Demo1.DeepOceanThemeLauncherIndicatorColor,
      Demo1.DeepOceanThemeLauncherIndicatorWidth,
      Demo1.DeepOceanThemeLauncherIndicatorDuration,
      Demo1.DeepOceanThemeLauncherDismissDuration,
      Demo1.DeepOceanThemeActionSurfaceBackground,
      Demo1.DeepOceanThemeActionHoverSurfaceBackground,
      Demo1.DeepOceanThemeActionTextColor,
      Demo1.DeepOceanThemeActionPaddingBlock,
      Demo1.DeepOceanThemeActionPaddingInline,
      Demo1.DeepOceanThemeActionCornerRadius,

      Demo1.DeepOceanThemeCanvasFontFamily,
      Demo1.DeepOceanThemeCanvasFontSize,
      Demo1.DeepOceanThemeCanvasFontWeight,
      Demo1.DeepOceanThemeCanvasLineHeight,
      Demo1.DeepOceanThemeCanvasHeadingFontWeight,
      Demo1.DeepOceanThemeCanvasContentMinHeight,
      Demo1.DeepOceanThemePropertiesDisclosureFocusColor,
      Demo1.DeepOceanThemeSlotBorderColor,
      Demo1.DeepOceanThemeSlotBorderWidth,
      Demo1.DeepOceanThemeSlotBorderStyle,
      Demo1.DeepOceanThemeSlotPadding,
      Demo1.DeepOceanThemeInspectorRailWidth,
      Demo1.DeepOceanThemeInspectorContentMinHeight,
      Demo1.DeepOceanThemePropertiesHeadingGap,
      Demo1.DeepOceanThemePropertiesRowGap,
      Demo1.DeepOceanThemePropertiesHeadingFontSize,
      Demo1.DeepOceanThemePropertiesHeadingFontWeight,
      Demo1.DeepOceanThemePropertyColumnGap,
      Demo1.DeepOceanThemePropertyNameMinWidth,
      Demo1.DeepOceanThemeTableCellBorderStyle,
      Demo1.DeepOceanThemeCollectionHeadingFontSize,
      Demo1.DeepOceanThemeCollectionHeadingFontWeight,
      Demo1.DeepOceanThemeTableHeaderFontWeight,

      Demo1.DeepOceanThemeCanvasGap,
      Demo1.DeepOceanThemeCanvasPadding,
      Demo1.DeepOceanThemeCanvasSurfaceBackground,
      Demo1.DeepOceanThemeCanvasTextColor,
      Demo1.DeepOceanThemeCollectionSurfaceBackground,
      Demo1.DeepOceanThemeCollectionTextColor,
      Demo1.DeepOceanThemeCollectionHeaderSurfaceBackground,
      Demo1.DeepOceanThemeTableHeaderSurfaceBackground,
      Demo1.DeepOceanThemeTableHeaderTextColor,
      Demo1.DeepOceanThemeTableCellBorderColor,
      Demo1.DeepOceanThemeTableCellBorderWidth,
      Demo1.DeepOceanThemeTableCellPadding
    ]
    OfferedByHolonSpace -> MAP.CoreSchemaSpace
  }
}

