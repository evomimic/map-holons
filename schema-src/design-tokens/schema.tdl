schema "MAP Design Tokens Schema-v0.1.0" {
  depends_on "MAP Core Schema-v0.0.7"
  header {
    description: "MAP vocabulary for named semantic DesignTokens and their DTCG-aligned DesignTokenTypes. It intentionally defines neither Meta Design Systems, Themes, aliases, groups, primitive/reference-token layers, nor DTCG serialization."
  }
}

// The Space Navigator visualizers consume this reusable semantic vocabulary;
// visualizers and MetaDesignSystems do not own the tokens themselves.
instance CanvasGap.DesignToken {
  type DesignToken.HolonType
  DesignTokenName "CanvasGap"
  relationships {
    HasDesignTokenType -> Dimension.DesignTokenType
  }
}

instance CanvasPadding.DesignToken {
  type DesignToken.HolonType
  DesignTokenName "CanvasPadding"
  relationships {
    HasDesignTokenType -> Dimension.DesignTokenType
  }
}

