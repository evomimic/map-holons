holon ActionBarVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Composes contextual actions into uniformly allocated slots and groups."
    display_name: "Action Bar Visualizer"
    display_plural: "Action Bar Visualizers"
