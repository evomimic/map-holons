  relationships {
    InputType -> PresentationActionInput.HolonType
    ResultType -> PresentationResult.HolonType
  }
}

// Loader results prefer the compact title; the generic inline title remains an
// ancestor alternative through ordinary discovery and explicit choice.
instance CompactTitleBar.TitleBarVisualizer {
  type TitleBarVisualizer.HolonType
  DisplayName "Compact Node Title"
  VisualizerDescription "Compact subject identity and bound Restore access; the containing Node owns the sibling ActionBar."
  relationships {
    ApplicableToType -> HolonLoadResponse.DanceResponseType
    OffersOperator -> ApplyTitlePresentation.VisualizerOperator
    ImplementedBy -> CompactTitleBarTypeScript.VisualizerImplementation
  }
}

instance CompactTitleBarTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.compact-title-bar"
  VisualizerArtifactDigest "sha256:f0cb5706a8dbbbcf4b14d3631d83c3b89185d9b95717c20259341fd5394cd346"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

property ActionIcon.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  header {
    description: "Optional independently defined icon text for an Action component."
    display_name: "Action Icon"
    display_plural: "Action Icons"
    plural: "ActionIcons"
  }
}
