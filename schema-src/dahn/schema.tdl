  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.unsupported-action"
  VisualizerArtifactDigest "sha256:e1e8cd6283283262560407e5248f36afec5cd44796ec5ba1972397469f16691f"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

instance LoadHolons.ActionVisualizer {
  type ActionVisualizer.HolonType
  DisplayName "Load Holons"
  VisualizerDescription "Uses a labeled button to select data from your computer, then opens a load-results view where you can review progress, problems, and saved items."
  relationships {
    HasSlot -> [LoadHolons.DiagnosticsSlot, LoadHolons.CommittedHolonsSlot]
    ApplicableToType -> LoadHolons.DanceType
    ImplementedBy -> LoadHolonsActionTypeScript.VisualizerImplementation
  }
}

instance LoadHolons.DiagnosticsSlot {
