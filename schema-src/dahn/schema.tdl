// The response's concrete type selects this Node before the generic ancestor.
instance LoadHolons.NodeVisualizer {
  type NodeVisualizer.HolonType
  DisplayName "Load Holons"
  VisualizerDescription "Groups load-result details above tabbed result collections, with a side rail for related items. The title bar supports the same exploration and expansion controls as Holon Inspector."
  relationships {
    ApplicableToType -> HolonLoadResponse.DanceResponseType
    HasSlot -> [LoadHolonsResult.PropertyMapSlot, LoadHolonsResult.ActionsSlot, LoadHolonsResult.CollectionsSlot]
    ImplementedBy -> LoadHolonsInspectorTypeScript.VisualizerImplementation
  }
}

instance LoadHolonsInspectorTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.load-holons-inspector"
  VisualizerArtifactDigest "sha256:4130b0052bac015c8023c0320456b785b47f09a74f555e0753da4683c8ea950a"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

instance LoadHolonsResult.PropertyMapSlot {
  type VisualizerSlot.HolonType
  VisualizerSlotDescription "Explain the outcome of this data load, including its status and result counts."
  relationships {
    AcceptsVisualizerType -> PropertyMapVisualizer.HolonType
  }
}

instance LoadHolonsResult.ActionsSlot {
  type VisualizerSlot.HolonType
  VisualizerSlotDescription "Provide access to the actions available for this load result."
  relationships {
    AcceptsVisualizerType -> ActionBarVisualizer.HolonType
  }
}

instance LoadHolonsResult.CollectionsSlot {
  type VisualizerSlot.HolonType
  VisualizerSlotDescription "Present a group of items related to this load result so you can examine them and open an item."
  relationships {
    AcceptsVisualizerType -> CollectionVisualizer.HolonType
  }
}

