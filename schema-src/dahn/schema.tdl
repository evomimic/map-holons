schema "MAP DAHN Schema-v0.1.0" {
  depends_on "MAP Core Schema-v0.0.7"
  depends_on "MAP Dance Schema-v0.1.0"
  depends_on "MAP Design Tokens Schema-v0.1.0"
  depends_on "MAP Meta Design System Schema-v0.1.0"
  header {
    description: "Non-Core MAP schema for first-class Visualizer Holons, their executable realizations, and type-based applicability. Capability taxonomies, compatibility/release contracts, Visualizer Commons stewardship, and dynamic acquisition are deliberately deferred."
  }
}

holon MaterializedVisualizer.Projection {
  type MetaHolonType.MetaTypeDescriptor
  extends Projection.HolonType
  header {
    description: "Transient response-body projection containing an opaque handle to one Rust-authorized executable realization of a selected Visualizer Holon. The module source remains in the artifact backend and is retrieved through the artifact command boundary."
    display_name: "Materialized Visualizer"
    display_plural: "Materialized Visualizers"
    plural: "MaterializedVisualizers"
  }
  relationships {
    InstanceProperties -> [
      VisualizerArtifactHandle.PropertyType,
      VisualizerModuleFormat.PropertyType,
      Entrypoint.PropertyType
    ]
  }
}

holon MaterializeVisualizerResponse.DanceResponseType {
  type MetaDanceResponseType.MetaHolonType
  extends DanceResponseType.HolonType
  header {
    description: "Dance response wrapping a transient MaterializedVisualizer projection."
    display_name: "Materialize Visualizer Response"
    display_plural: "Materialize Visualizer Responses"
    plural: "MaterializeVisualizerResponses"
  }
  relationships {
    ResponseBody -> MaterializedVisualizer.Projection
  }
}

holon MaterializeVisualizer.DanceType {
  type MetaDanceType.MetaHolonType
  extends DanceType.HolonType
  DanceDescription "Materializes executable code for one selected Visualizer Holon through the Rust-owned artifact backend."
  RequiredExecutionContext HostAuthoritative
  header {
    description: "Visualizer-afforded dance that retrieves one executable realization without making frontend caches an authority."
    display_name: "Materialize Visualizer Dance"
    display_plural: "Materialize Visualizer Dances"
    plural: "MaterializeVisualizerDances"
  }
  relationships {
    Response -> MaterializeVisualizerResponse.DanceResponseType
    DanceAffordedBy -> Visualizer.HolonType
  }
}

// Materialization is DAHN-wide infrastructure. It is intentionally Core
// bootstrap content, rather than a Space Navigator package dependency.
instance LocalMaterializeVisualizer.DanceImplementation {
  type DanceImplementation.HolonType
  ImplementationName "LocalMaterializeVisualizer"
  relationships {
    ForDance -> MaterializeVisualizer.DanceType
  }
}

holon MetaVisualizerType.MetaHolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends MetaHolonType.MetaTypeDescriptor
  header {
    description: "Meta-type for Visualizer Holon Type descriptors. It identifies the descriptor family whose instances are DAHN Visualizer Holons and provides a semantic target for Visualizer-role composition and discovery."
    display_name: "Meta Visualizer Type"
    display_plural: "Meta Visualizer Types"
    plural: "MetaVisualizerTypes"
  }
}

abstract holon Visualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends HolonType.TypeDescriptor
  DefinesInstanceTypeKind true
  header {
    description: "Abstract family anchor for DAHN Visualizer Holon Types. Ordinary Visualizer Holons must be described by concrete descendants; their semantic identity is distinct from executable implementation identities. A Visualizer defines its semantic Slots and owns the presentation strategy that dynamically composes them within the allocation supplied by its parent."
    display_name: "Visualizer"
    display_plural: "Visualizers"
    plural: "Visualizers"
  }
  relationships {
    InstanceRelationships -> [
      (Visualizer.HolonType)-[ImplementedBy]->(VisualizerImplementation.HolonType),
      (Visualizer.HolonType)-[ApplicableToType]->(TypeDescriptor),
      (Visualizer.HolonType)-[HasSlot]->(VisualizerSlot.HolonType),
      (Visualizer.HolonType)-[ConsumesDesignToken]->(DesignToken.HolonType)
    ]
  }
}

holon Canvas.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "A coherent experience container bound to one MetaDesignSystem. It may contain only Visualizers that support that system."
    display_name: "Canvas"
    display_plural: "Canvases"
    plural: "Canvases"
  }
  relationships {
    InstanceRelationships -> [
      (Canvas.HolonType)-[UsesMetaDesignSystem]->(MetaDesignSystem.HolonType),
      (Canvas.HolonType)-[ContainsVisualizer]->(Visualizer.HolonType)
    ]
  }
}

holon CanvasVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Concrete Visualizer Holon Type for visualizers that compose a canvas experience."
    display_name: "Canvas Visualizer"
    display_plural: "Canvas Visualizers"
    plural: "CanvasVisualizers"
  }
}

// This generic Canvas and its Canvas Visualizer are bootstrap resources, not
// Space Navigator resources. Selection policy may currently choose this sole
// compatible candidate, but no caller may substitute it after a failed match.
instance MAP.BootstrapCanvas {
  type Canvas.HolonType
  relationships {
    UsesMetaDesignSystem -> MAP.BootstrapMetaDesignSystem
    ContainsVisualizer -> MAP.BootstrapCanvasVisualizer
  }
}

instance MAP.BootstrapCanvasVisualizer {
  type CanvasVisualizer.HolonType
  relationships {
    ConsumesDesignToken -> [
      CanvasContentMinHeight.DesignToken,
      CanvasFontFamily.DesignToken,
      CanvasFontSize.DesignToken,
      CanvasFontWeight.DesignToken,
      CanvasGap.DesignToken,
      CanvasHeadingFontWeight.DesignToken,
      CanvasLineHeight.DesignToken,
      CanvasPadding.DesignToken,
      CanvasSurfaceBackground.DesignToken,
      CanvasTextColor.DesignToken,
      SlotBorderColor.DesignToken,
      SlotBorderStyle.DesignToken,
      SlotBorderWidth.DesignToken,
      SlotPadding.DesignToken,
    ]
    ApplicableToType -> Canvas.HolonType
    ImplementedBy -> MAP.BootstrapCanvasTypeScript.VisualizerImplementation
  }
}

instance MAP.BootstrapCanvasTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.bootstrap-canvas"
  VisualizerArtifactDigest "sha256:0beb61de47c1c6fb9ea7ced7f7062b576f8ceb7e42501019f98c50b9d4c3395a"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

// Holon Inspector is the DAHN-wide Node Visualizer. It begins as the least
// specific Node candidate and is discovered only through Type applicability.
instance HolonInspector.NodeVisualizer {
  type NodeVisualizer.HolonType
  relationships {
    ConsumesDesignToken -> [
      CanvasGap.DesignToken,
      InspectorContentMinHeight.DesignToken,
      InspectorRailWidth.DesignToken,
      SlotBorderColor.DesignToken,
      SlotBorderStyle.DesignToken,
      SlotBorderWidth.DesignToken,
      SlotPadding.DesignToken,
    ]
    ApplicableToType -> HolonType.TypeDescriptor
    HasSlot -> HolonInspector.PropertyViewerSlot
    ImplementedBy -> HolonInspectorTypeScript.VisualizerImplementation
  }
}

instance HolonInspector.PropertyViewerSlot {
  type VisualizerSlot.HolonType
  relationships {
    AcceptsVisualizerType -> PropertiesVisualizer.HolonType
  }
}

instance HolonInspectorTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.holon-inspector"
  VisualizerArtifactDigest "sha256:293a0a63fe24d5d8af6aaf61beb2e71b163013a9ab23d5aa168c71242941d18b"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

holon NodeVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Concrete Visualizer Holon Type for visualizers that represent individual holons."
    display_name: "Node Visualizer"
    display_plural: "Node Visualizers"
    plural: "NodeVisualizers"
  }
}

holon StructureVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Concrete Visualizer Holon Type for visualizers that realize a multi-Holon semantic structure organized by a topology."
    display_name: "Structure Visualizer"
    display_plural: "Structure Visualizers"
    plural: "StructureVisualizers"
  }
}

holon RootedNavigationVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends StructureVisualizer.HolonType
  header {
    description: "Structure Visualizer subkind for interaction-derived navigation rooted at one Holon."
    display_name: "Rooted Navigation Visualizer"
    display_plural: "Rooted Navigation Visualizers"
    plural: "RootedNavigationVisualizers"
  }
}

// Path Inspector is the first RootedNavigation Structure visualizer. Its
// root subject is a HolonSpace; it owns the Node Visualizer slot used to
// realize that root without becoming a Node Visualizer itself.
instance PathInspector.RootedNavigationVisualizer {
  type RootedNavigationVisualizer.HolonType
  relationships {
    ConsumesDesignToken -> [
      CanvasGap.DesignToken,
      SlotBorderColor.DesignToken,
      SlotBorderStyle.DesignToken,
      SlotBorderWidth.DesignToken,
      SlotPadding.DesignToken,
    ]
    ApplicableToType -> HolonSpace.HolonType
    HasSlot -> PathInspector.RootNodeSlot
    ImplementedBy -> PathInspectorTypeScript.VisualizerImplementation
  }
}

instance PathInspector.RootNodeSlot {
  type VisualizerSlot.HolonType
  relationships {
    AcceptsVisualizerType -> NodeVisualizer.HolonType
  }
}

instance PathInspectorTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.path-inspector"
  VisualizerArtifactDigest "sha256:ca1e44811c1ac335c5132a83b72bc1706e3c2d709207e586ddc8ec6ee0451034"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

holon CollectionVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Concrete Visualizer Holon Type for visualizers that represent holon collections."
    display_name: "Collection Visualizer"
    display_plural: "Collection Visualizers"
    plural: "CollectionVisualizers"
  }
}

holon PropertiesVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Concrete Visualizer Holon Type for visualizers that represent a set of Properties within one presentation strategy."
    display_name: "Properties Visualizer"
    display_plural: "Properties Visualizers"
    plural: "PropertiesVisualizers"
  }
}

holon PropertyVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Concrete Visualizer Holon Type for visualizers that compose one descriptor-defined property name with a selected Value Visualizer. It does not own set-level layout."
    display_name: "Property Visualizer"
    display_plural: "Property Visualizers"
    plural: "PropertyVisualizers"
  }
}

// The generic Properties presentation owns the property-set layout. It is
// applicable to the ordinary HolonType lineage so every generic Node can bind
// it through its Property Viewer slot without a bootstrap fallback.
instance GenericProperties.PropertiesVisualizer {
  type PropertiesVisualizer.HolonType
  relationships {
    ConsumesDesignToken -> [
      PropertiesHeadingFontSize.DesignToken,
      PropertiesHeadingFontWeight.DesignToken,
      PropertiesHeadingGap.DesignToken,
      PropertiesRowGap.DesignToken,
    ]
    ApplicableToType -> HolonType.TypeDescriptor
    HasSlot -> GenericProperties.PropertySlot
    ImplementedBy -> GenericPropertiesTypeScript.VisualizerImplementation
  }
}

instance GenericProperties.PropertySlot {
  type VisualizerSlot.HolonType
  relationships {
    AcceptsVisualizerType -> PropertyVisualizer.HolonType
  }
}

instance GenericPropertiesTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.properties"
  VisualizerArtifactDigest "sha256:58c1bc54c92f11864bd966c1f4018b434460e827ed412b8bd99840076c54d340"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

// The generic property presentation is selected for each PropertyDescriptor.
// It is intentionally distinct from PropertiesVisualizer: it owns only one
// name/value row and its Value slot, never set-level layout or spatial budget.
instance GenericProperty.PropertyVisualizer {
  type PropertyVisualizer.HolonType
  relationships {
    ConsumesDesignToken -> [
      PropertyColumnGap.DesignToken,
      PropertyNameMinWidth.DesignToken,
    ]
    ApplicableToType -> PropertyType.TypeDescriptor
    HasSlot -> GenericProperty.ValueSlot
    ImplementedBy -> GenericPropertyTypeScript.VisualizerImplementation
  }
}

instance GenericProperty.ValueSlot {
  type VisualizerSlot.HolonType
  relationships {
    AcceptsVisualizerType -> ValueVisualizer.HolonType
  }
}

instance GenericPropertyTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.property"
  VisualizerArtifactDigest "sha256:d636db6711922debf05b10986e503062ae9a503e6bf25eabb562faaf884cad72"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

holon ValueVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Concrete Visualizer Holon Type for visualizers that represent values."
    display_name: "Value Visualizer"
    display_plural: "Value Visualizers"
    plural: "ValueVisualizers"
  }
}

// These semantic identities are selected independently for their declared
// ValueType lineages. The first client shares one scalar read-only executable
// implementation while retaining distinct ValueVisualizer identity.
instance StringValue.ValueVisualizer {
  type ValueVisualizer.HolonType
  relationships {
    ApplicableToType -> StringValueType.ValueType
    ImplementedBy -> ScalarValueTypeScript.VisualizerImplementation
  }
}

instance IntegerValue.ValueVisualizer {
  type ValueVisualizer.HolonType
  relationships {
    ApplicableToType -> IntegerValueType.ValueType
    ImplementedBy -> ScalarValueTypeScript.VisualizerImplementation
  }
}

instance BooleanValue.ValueVisualizer {
  type ValueVisualizer.HolonType
  relationships {
    ApplicableToType -> BooleanValueType.ValueType
    ImplementedBy -> ScalarValueTypeScript.VisualizerImplementation
  }
}

instance EnumValue.ValueVisualizer {
  type ValueVisualizer.HolonType
  relationships {
    ApplicableToType -> EnumValueType.ValueType
    ImplementedBy -> ScalarValueTypeScript.VisualizerImplementation
  }
}

instance BytesValue.ValueVisualizer {
  type ValueVisualizer.HolonType
  relationships {
    ApplicableToType -> BytesValueType.ValueType
    ImplementedBy -> ScalarValueTypeScript.VisualizerImplementation
  }
}

instance ScalarValueTypeScript.VisualizerImplementation {
  type VisualizerImplementation.HolonType
  VisualizerImplementationRuntime TypeScript
  VisualizerImplementationKey "dahn.scalar-value"
  VisualizerArtifactDigest "sha256:7b8cd6b923b5259e80248fb00dd7920571c4ab2e033d9a6cb3c6d34cf2a32dd4"
  VisualizerModuleFormat "ESModule"
  Entrypoint "default"
}

holon ActionVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Concrete Visualizer Holon Type for visualizers that represent actions."
    display_name: "Action Visualizer"
    display_plural: "Action Visualizers"
    plural: "ActionVisualizers"
  }
}

holon GraphVisualizer.HolonType {
  type MetaVisualizerType.MetaHolonType
  extends Visualizer.HolonType
  header {
    description: "Concrete Visualizer Holon Type for visualizers that represent graph-oriented views."
    display_name: "Graph Visualizer"
    display_plural: "Graph Visualizers"
    plural: "GraphVisualizers"
  }
}

holon VisualizerImplementation.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Concrete semantic identity for one executable realization of a Visualizer Holon. Its runtime and stable implementation key support static resolution without making a client registry semantic authority. Acquisition, compatibility, and implementation-private behavior are deferred."
    display_name: "Visualizer Implementation"
    display_plural: "Visualizer Implementations"
    plural: "VisualizerImplementations"
  }
  relationships {
    InstanceProperties -> [
      VisualizerImplementationRuntime.PropertyType,
      VisualizerImplementationKey.PropertyType,
      VisualizerArtifactDigest.PropertyType,
      VisualizerModuleFormat.PropertyType,
      Entrypoint.PropertyType
    ]
  }
}

holon VisualizerSlot.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Semantic role within a Visualizer's composition that declares one or more accepted Visualizer Holon Type roles. It does not encode runtime occupancy or spatial geometry; selection and occupancy are recorded through VisualizerUsage."
    display_name: "Visualizer Slot"
    display_plural: "Visualizer Slots"
    plural: "VisualizerSlots"
  }
  relationships {
    InstanceRelationships -> (VisualizerSlot.HolonType)-[AcceptsVisualizerType]->(MetaVisualizerType.MetaHolonType)
  }
}

holon VisualizerUsage.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "A context-owned use of a selected Visualizer to fulfill a VisualizerSlot. It separates shared Visualizer capability from future circumstance, configuration, and selection-history state without defining those extensions yet."
    display_name: "Visualizer Usage"
    display_plural: "Visualizer Usages"
    plural: "VisualizerUsages"
  }
  relationships {
    InstanceRelationships -> [
      (VisualizerUsage.HolonType)-[UsesVisualizer]->(Visualizer.HolonType),
      (VisualizerUsage.HolonType)-[FillsVisualizerSlot]->(VisualizerSlot.HolonType)
    ]
  }
}

relationship (Visualizer.HolonType)-[ImplementedBy]->(VisualizerImplementation.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
    HasInverse -> ImplementsVisualizer
  }
  extends DeclaredRelationshipType.RelationshipType
  source Visualizer.HolonType
  target VisualizerImplementation.HolonType
  deletion_semantic Allow
  header {
    description: "Relates a Visualizer Holon to one or more executable realization identities without making any realization the Visualizer's durable semantic identity."
    display_name: "ImplementedBy Relationship"
    display_plural: "ImplementedBy Relationships"
    plural: "ImplementedByRelationships"
  }
}

inverse relationship (VisualizerImplementation.HolonType)-[ImplementsVisualizer]->(Visualizer.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source VisualizerImplementation.HolonType
  target Visualizer.HolonType
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of ImplementedBy. Each first-cut VisualizerImplementation realizes exactly one Visualizer Holon."
    display_name: "ImplementsVisualizer Relationship"
    display_plural: "ImplementsVisualizer Relationships"
    plural: "ImplementsVisualizerRelationships"
  }
}

relationship (Visualizer.HolonType)-[ApplicableToType]->(TypeDescriptor) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
    HasInverse -> HasApplicableVisualizer
  }
  extends DeclaredRelationshipType.RelationshipType
  source Visualizer.HolonType
  target TypeDescriptor
  deletion_semantic Allow
  header {
    description: "Declares a descriptor Type against which a selector evaluates a Visualizer Holon's applicability using its type lineage. Node and Properties visualizers target HolonType lineages; Property and Value visualizers may target PropertyType and ValueType lineages."
    display_name: "ApplicableToType Relationship"
    display_plural: "ApplicableToType Relationships"
    plural: "ApplicableToTypeRelationships"
  }
}

inverse relationship (TypeDescriptor)-[HasApplicableVisualizer]->(Visualizer.HolonType) {
  MembershipCacheMaxAgeMillis 30000
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source TypeDescriptor
  target Visualizer.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of ApplicableToType, exposing the Visualizer Holons applicable to a descriptor Type."
    display_name: "HasApplicableVisualizer Relationship"
    display_plural: "HasApplicableVisualizer Relationships"
    plural: "HasApplicableVisualizerRelationships"
  }
}

def relationship (Visualizer.HolonType)-[HasSlot]->(VisualizerSlot.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
    HasInverse -> SlotForVisualizer
  }
  extends DeclaredRelationshipType.RelationshipType
  source Visualizer.HolonType
  target VisualizerSlot.HolonType
  deletion_semantic Allow
  header {
    description: "Declares the semantic VisualizerSlots that a Visualizer requires for its internal composition."
    display_name: "HasSlot Relationship"
    display_plural: "HasSlot Relationships"
    plural: "HasSlotRelationships"
  }
}

inverse relationship (VisualizerSlot.HolonType)-[SlotForVisualizer]->(Visualizer.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source VisualizerSlot.HolonType
  target Visualizer.HolonType
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of HasSlot. Each first-cut VisualizerSlot belongs to exactly one Visualizer."
    display_name: "SlotForVisualizer Relationship"
    display_plural: "SlotForVisualizer Relationships"
    plural: "SlotForVisualizerRelationships"
  }
}

relationship (VisualizerSlot.HolonType)-[AcceptsVisualizerType]->(MetaVisualizerType.MetaHolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> OneOrMore.CardinalityConstraint
    HasInverse -> AcceptedByVisualizerSlot
  }
  extends DeclaredRelationshipType.RelationshipType
  source VisualizerSlot.HolonType
  target MetaVisualizerType.MetaHolonType
  deletion_semantic Allow
  header {
    description: "Declares one or more Visualizer Holon Type roles accepted by a semantic Slot. Its cardinality applies to accepted role declarations, not runtime occupancy; the selected Visualizer is bound through a VisualizerUsage."
    display_name: "AcceptsVisualizerType Relationship"
    display_plural: "AcceptsVisualizerType Relationships"
    plural: "AcceptsVisualizerTypeRelationships"
  }
}

inverse relationship (MetaVisualizerType.MetaHolonType)-[AcceptedByVisualizerSlot]->(VisualizerSlot.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source MetaVisualizerType.MetaHolonType
  target VisualizerSlot.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of AcceptsVisualizerType, exposing the semantic slots that accept a Visualizer Holon Type role."
    display_name: "AcceptedByVisualizerSlot Relationship"
    display_plural: "AcceptedByVisualizerSlot Relationships"
    plural: "AcceptedByVisualizerSlotRelationships"
  }
}

relationship (VisualizerUsage.HolonType)-[UsesVisualizer]->(Visualizer.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
    HasInverse -> UsedByVisualizerUsage
  }
  extends DeclaredRelationshipType.RelationshipType
  source VisualizerUsage.HolonType
  target Visualizer.HolonType
  deletion_semantic Allow
  header {
    description: "Identifies the shared Visualizer capability used by one context-owned VisualizerUsage."
    display_name: "Uses Visualizer Relationship"
    display_plural: "Uses Visualizer Relationships"
    plural: "UsesVisualizerRelationships"
  }
}

inverse relationship (Visualizer.HolonType)-[UsedByVisualizerUsage]->(VisualizerUsage.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source Visualizer.HolonType
  target VisualizerUsage.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of UsesVisualizer, exposing context-owned usages of a shared Visualizer."
    display_name: "Used By Visualizer Usage Relationship"
    display_plural: "Used By Visualizer Usage Relationships"
    plural: "UsedByVisualizerUsageRelationships"
  }
}

relationship (VisualizerUsage.HolonType)-[FillsVisualizerSlot]->(VisualizerSlot.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
    HasInverse -> FulfilledByVisualizerUsage
  }
  extends DeclaredRelationshipType.RelationshipType
  source VisualizerUsage.HolonType
  target VisualizerSlot.HolonType
  deletion_semantic Allow
  header {
    description: "Binds a context-owned VisualizerUsage to the VisualizerSlot it fulfills without making the Slot select a concrete Visualizer directly."
    display_name: "Fills Visualizer Slot Relationship"
    display_plural: "Fills Visualizer Slot Relationships"
    plural: "FillsVisualizerSlotRelationships"
  }
}

inverse relationship (VisualizerSlot.HolonType)-[FulfilledByVisualizerUsage]->(VisualizerUsage.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source VisualizerSlot.HolonType
  target VisualizerUsage.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of FillsVisualizerSlot, exposing the context-owned usages through which a Slot is fulfilled."
    display_name: "Fulfilled By Visualizer Usage Relationship"
    display_plural: "Fulfilled By Visualizer Usage Relationships"
    plural: "FulfilledByVisualizerUsageRelationships"
  }
}

property VisualizerImplementationRuntime.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value VisualizerImplementationRuntime.MapEnumValueType
  IsValueRequired true
  header {
    description: "Runtime in which a VisualizerImplementation is executable; the initial runtime set is intentionally small and extensible."
    display_name: "visualizer_implementation_runtime"
    display_plural: "visualizer_implementation_runtimes"
    plural: "VisualizerImplementationRuntimes"
  }
}

property VisualizerImplementationKey.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  IsValueRequired true
  header {
