  }
}

instance UnsupportedAction.ActionVisualizer {
  type ActionVisualizer.HolonType
  DisplayName "Unsupported Action"
  VisualizerDescription "Displays the action’s name on a disabled button, with an explanation that its interaction is unavailable."
