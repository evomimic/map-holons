// Rust-authored transient evidence; discovery and presentation lifecycles are distinct.
holon VisualizerDiscovery.Projection {
  type MetaHolonType.MetaTypeDescriptor
  extends Projection.HolonType
  header {
    description: "Captured authoritative Visualizer discovery evidence, never a second discovery path."
    display_name: "VisualizerDiscovery"
    display_plural: "VisualizerDiscovery Records"
    plural: "VisualizerDiscoveryRecords"
  }
  relationships {
    InstanceProperties -> [DiscoveryStopReason.PropertyType, DiscoveryRequestedKind.PropertyType, SelectionRationale.PropertyType]
    InstanceRelationships -> [
      (VisualizerDiscovery.Projection)-[DiscoverySubject]->(HolonType.TypeDescriptor),
      (VisualizerDiscovery.Projection)-[DiscoverySlot]->(VisualizerSlot.HolonType),
      (VisualizerDiscovery.Projection)-[DiscoveryOwner]->(HolonType.TypeDescriptor),
      (VisualizerDiscovery.Projection)-[DiscoveryTheme]->(HolonType.TypeDescriptor),
      (VisualizerDiscovery.Projection)-[DiscoveryCurrentVisualizer]->(Visualizer.HolonType),
      (VisualizerDiscovery.Projection)-[DiscoveryEndpoint]->(TypeDescriptor),
      (VisualizerDiscovery.Projection)-[DiscoveryLevels]->(VisualizerDiscoveryLevel.Projection),
      (VisualizerDiscovery.Projection)-[DiscoveryCandidates]->(VisualizerDiscoveryCandidate.Projection)
    ]
  }
}

holon VisualizerDiscoveryLevel.Projection {
  type MetaHolonType.MetaTypeDescriptor
  extends Projection.HolonType
