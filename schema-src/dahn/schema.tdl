holon VisualizerImplementation.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Concrete semantic identity for one executable realization of a Visualizer Holon. Its runtime and stable implementation key support static resolution without making a client registry semantic authority. Acquisition, compatibility, and implementation-private behavior are deferred."
    display_name: "Visualizer Implementation"
    display_plural: "Visualizer Implementations"
    plural: "VisualizerImplementations"
  }
  relationships {
    InstanceProperties -> [
      VisualizerImplementationRuntime.PropertyType,
      VisualizerImplementationKey.PropertyType,
      VisualizerArtifactDigest.PropertyType,
      VisualizerModuleFormat.PropertyType,
      Entrypoint.PropertyType
    ]
  }
}

holon VisualizerSlot.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Semantic role within a Visualizer's composition that declares one or more accepted Visualizer Holon Type roles. It does not encode runtime occupancy or spatial geometry. Retained usage associations record successful presentations; descriptor-specific preference records identify remembered choices."
    display_name: "Visualizer Slot"
    display_plural: "Visualizer Slots"
    plural: "VisualizerSlots"
  }
  relationships {
    InstanceProperties -> VisualizerSlotDescription.PropertyType
    InstanceRelationships -> [(VisualizerSlot.HolonType)-[AcceptsVisualizerType]->(MetaVisualizerType.MetaHolonType), (VisualizerSlot.HolonType)-[RequiresOperator]->(VisualizerOperator.HolonType), (VisualizerSlot.HolonType)-[UsesNodeActionsContract]->(NodeActionsContract.HolonType)]
  }
}

holon VisualizerUsage.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "The local space agent's use and personalized configuration of a selected Visualizer for one subject descriptor. Preparation alone does not record successful use. Empty override relationships preserve neutral default presentation."
    display_name: "Visualizer Usage"
    display_plural: "Visualizer Usages"
    plural: "VisualizerUsages"
  }
  relationships {
    InstanceRelationships -> [
      (VisualizerUsage.HolonType)-[UsesVisualizer]->(Visualizer.HolonType),
      (VisualizerUsage.HolonType)-[SelectedForSlot]->(VisualizerSlot.HolonType),
      (VisualizerUsage.HolonType)-[ForSubjectType]->(TypeDescriptor),
