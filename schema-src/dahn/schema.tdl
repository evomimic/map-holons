  }
}

instance HolonInspector.CollectionsSlot {
  type VisualizerSlot.HolonType
  VisualizerSlotDescription "Present a group of related items so you can examine its members and open an item."
  relationships {
    AcceptsVisualizerType -> CollectionVisualizer.HolonType
  }
}

instance HolonInspector.SingleValueSlot {
  type VisualizerSlot.HolonType
  VisualizerSlotDescription "Inspect the item reached through a connection that has a single destination."
