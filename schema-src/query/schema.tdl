  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source QueryExpression.HolonType
  target Query.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of RootExpression."
    display_name: "Root Expression For"
    display_plural: "Root Expression Fors"
    plural: "RootExpressionFors"
  }
}

