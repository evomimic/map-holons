meta {
  export_mode: "design-seed"
  source_files: ["docs/core/map-queries/command-dance-query-schema-tdl.md","docs/core/map-queries/query-engine-design-spec.md","docs/core/map-queries/queries-impl-plan.md"]
  load_with: ["../core/root.json","../core/concrete-value-types.json","../core/abstract-value-types.json","../core/property-types.json","../core/relationship-types.json"]
}

schema "MAP Query Schema-v0.0.2" {
  depends_on "MAP Core Schema-v0.0.7"
  header {
    description: "Descriptor definitions for reusable MAP queries and their direct runtime execution state. Dance-mediated invocation is owned by the separate Query Dance Adapter Schema."
  }
}

holon Query.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Reusable saved query definition rooted at a QueryExpression. It never carries invocation state."
    display_name: "Query"
    display_plural: "Queries"
    plural: "Queries"
  }
  relationships {
    InstanceProperties -> [QueryName.PropertyType, QueryDescription.PropertyType]
    InstanceRelationships -> (Query.HolonType)-[RootExpression]->(QueryExpression.HolonType)
  }
}

abstract holon QueryExpression.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Reusable query-expression definition. Concrete operators extend this type."
    display_name: "Query Expression"
    display_plural: "Query Expressions"
    plural: "QueryExpressions"
  }
  relationships {
    InstanceRelationships -> [
      (QueryExpression.HolonType)-[ExpressionParameters]->(QueryParameterDeclaration.HolonType),
      (QueryExpression.HolonType)-[Next]->(QueryExpression.HolonType)
    ]
  }
}

holon QuerySubTree.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends QueryExpression.HolonType
  header {
    description: "Composite QueryExpression whose ordered Subtree members are implementation containment, not continuation."
    display_name: "Query Subtree"
    display_plural: "Query Subtrees"
    plural: "QuerySubTrees"
  }
  relationships {
    InstanceRelationships -> (QuerySubTree.HolonType)-[Subtree]->(QueryExpression.HolonType)
  }
}

holon SeedHolons.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends QueryExpression.HolonType
  header {
    description: "Root-only source expression. Expands the invocation's focal HolonSpace over its Owns relationship; accepts no input collection. SeedPredicate is an optional payload with no QRY2 evaluation."
    display_name: "Seed Holons"
    display_plural: "Seed Holons Expressions"
    plural: "SeedHolonsExpressions"
  }
  relationships {
    InstanceRelationships -> (SeedHolons.HolonType)-[SeedPredicate]->(QueryPredicate.HolonType)
  }
}

holon Expand.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends QueryExpression.HolonType
  header {
    description: "Navigation expression. Expands each input member over the named outbound relationship resolved through the member's HolonDescriptor. ExpansionPredicate is an optional payload with no QRY2 evaluation."
    display_name: "Expand"
    display_plural: "Expand Expressions"
    plural: "ExpandExpressions"
  }
  relationships {
    InstanceProperties -> ExpansionRelationshipName.PropertyType
    InstanceRelationships -> (Expand.HolonType)-[ExpansionPredicate]->(QueryPredicate.HolonType)
  }
}

abstract holon QueryPredicate.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Abstract predicate attached to a query expression. Concrete predicate forms, operators, and evaluation are defined by later slices."
    display_name: "Query Predicate"
    display_plural: "Query Predicates"
    plural: "QueryPredicates"
  }
}

holon QueryParameterDeclaration.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Reusable declaration of a parameter accepted by a query expression."
    display_name: "Query Parameter Declaration"
    display_plural: "Query Parameter Declarations"
    plural: "QueryParameterDeclarations"
  }
  relationships {
    InstanceProperties -> ParameterName.PropertyType
    InstanceRelationships -> (QueryParameterDeclaration.HolonType)-[ParameterBindingType]->(HolonType.TypeDescriptor)
  }
}

abstract holon QueryParameterBinding.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Runtime value binding for a QueryParameterDeclaration. Concrete binding types own their values."
    display_name: "Query Parameter Binding"
    display_plural: "Query Parameter Bindings"
    plural: "QueryParameterBindings"
  }
  relationships {
    InstanceProperties -> ParameterName.PropertyType
    InstanceRelationships -> (QueryParameterBinding.HolonType)-[BindsParameter]->(QueryParameterDeclaration.HolonType)
  }
}

holon ExecutionInstance.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Runtime state for one direct or Dance-mediated execution of a Query."
    display_name: "Execution Instance"
    display_plural: "Execution Instances"
    plural: "ExecutionInstances"
  }
  relationships {
    InstanceProperties -> ExecutionStatus.PropertyType
    InstanceRelationships -> [
      (ExecutionInstance.HolonType)-[ExecutesQuery]->(Query.HolonType),
      (ExecutionInstance.HolonType)-[FocalSpace]->(HolonSpace.HolonType),
      (ExecutionInstance.HolonType)-[ExpressionExecutions]->(QueryExpressionExecution.HolonType),
      (ExecutionInstance.HolonType)-[ExecutionResult]->(HolonCollection.HolonType)
    ]
  }
}

holon QueryExpressionExecution.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Runtime state for one invocation of one QueryExpression."
    display_name: "Query Expression Execution"
    display_plural: "Query Expression Executions"
    plural: "QueryExpressionExecutions"
  }
  relationships {
    InstanceProperties -> ExecutionStatus.PropertyType
    InstanceRelationships -> [
      (QueryExpressionExecution.HolonType)-[ExecutesExpression]->(QueryExpression.HolonType),
      (QueryExpressionExecution.HolonType)-[Input]->(HolonCollection.HolonType),
      (QueryExpressionExecution.HolonType)-[Result]->(HolonCollection.HolonType),
      (QueryExpressionExecution.HolonType)-[RuntimeParameters]->(QueryParameterBinding.HolonType)
    ]
  }
}

property QueryName.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  IsValueRequired true
  header {
    description: "Human-readable name for a saved Query."
    display_name: "Query Name"
    display_plural: "Query Names"
    plural: "QueryNames"
  }
}

property QueryDescription.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  header {
    description: "Human-readable description of a Query."
    display_name: "Query Description"
    display_plural: "Query Descriptions"
    plural: "QueryDescriptions"
  }
}

property ParameterName.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  IsValueRequired true
  header {
    description: "Stable name of a declared or runtime query parameter."
    display_name: "Parameter Name"
    display_plural: "Parameter Names"
    plural: "ParameterNames"
  }
}

property ExpansionRelationshipName.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  IsValueRequired true
  header {
    description: "Name of the outbound relationship an Expand expression navigates; resolved against each source member's HolonDescriptor at execution time."
    display_name: "Expansion Relationship Name"
    display_plural: "Expansion Relationship Names"
    plural: "ExpansionRelationshipNames"
  }
}

property ExecutionStatus.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value QueryExecutionStatus.MapEnumValueType
  IsValueRequired true
  header {
    description: "Lifecycle status of a Query execution."
    display_name: "Execution Status"
    display_plural: "Execution Statuses"
    plural: "ExecutionStatuses"
  }
}

enum QueryExecutionStatus.MapEnumValueType {
  type MetaEnumValueType.MetaValueType
  extends MapEnumValueType.EnumValueType
  header {
    description: "Lifecycle states for a Query execution."
    display_name: "Query Execution Status"
    display_plural: "Query Execution Statuses"
    plural: "QueryExecutionStatuses"
  }
  variants {
    variant Pending {
      type MetaEnumVariantValueType.MetaValueType
      extends MapEnumVariantValueType.EnumVariantValueType
      header {
        description: "Execution has been created but has not started."
        display_name: "Pending"
      }
    }
    variant Running {
      type MetaEnumVariantValueType.MetaValueType
      extends MapEnumVariantValueType.EnumVariantValueType
      header {
        description: "Execution is in progress."
        display_name: "Running"
      }
    }
    variant Complete {
      type MetaEnumVariantValueType.MetaValueType
      extends MapEnumVariantValueType.EnumVariantValueType
      header {
        description: "Execution completed successfully."
        display_name: "Complete"
      }
    }
    variant Failed {
      type MetaEnumVariantValueType.MetaValueType
      extends MapEnumVariantValueType.EnumVariantValueType
      header {
        description: "Execution completed with failure."
        display_name: "Failed"
      }
    }
  }
}

def relationship (Query.HolonType)-[RootExpression]->(QueryExpression.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
    HasInverse -> RootExpressionFor
  }
  extends DeclaredRelationshipType.RelationshipType
  source Query.HolonType
  target QueryExpression.HolonType
  deletion_semantic Block
  header {
    description: "Identifies the root expression of a Query definition."
    display_name: "Root Expression"
    display_plural: "Root Expressions"
    plural: "RootExpressions"
  }
}

