  relationships {
    InstanceProperties -> [
      PreferenceTestDate.PropertyType,
      PreferenceTestDate2.PropertyType,
      PreferenceTestDate3.PropertyType,
      PreferenceTestDate4.PropertyType,
      PreferenceTestDate5.PropertyType,
      PreferenceTestDate6.PropertyType,
      PreferenceTestDate7.PropertyType,
      PreferenceTestDate8.PropertyType,
      PreferenceTestDate9.PropertyType,
      PreferenceTestDate10.PropertyType,
      PreferenceTestDate11.PropertyType,
      PreferenceTestDate12.PropertyType,
      PreferenceTestDate13.PropertyType,
      PreferenceTestDate14.PropertyType,
      PreferenceTestDate15.PropertyType,
      PreferenceTestDate16.PropertyType,
      PreferenceTestDate17.PropertyType,
      PreferenceTestDate18.PropertyType
    ]
  }
}

