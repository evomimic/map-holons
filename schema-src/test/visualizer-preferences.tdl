    description: "Test-only PreferenceTestDateProperty for semantic composition preferences."
    display_name: "PreferenceTestDateProperty"
    display_plural: "PreferenceTestDateProperty items"
    plural: "PreferenceTestDatePropertyItems"
  }
}

holon PreferenceTestRecord.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
