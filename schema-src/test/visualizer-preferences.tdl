meta {
  export_mode: "test-fixture"
}
schema VisualizerPreferenceTestSchema {
  depends_on "MAP Core Schema-v0.0.11"
  depends_on "MAP DAHN Schema-v0.1.4"
  header {
    description: "Test-only declared Date preferences across compatible compositions."
  }
}

value PreferenceTestDate.StringValueType {
  type MetaStringValueType.MetaValueType
  extends MapStringValueType.StringValueType
  header {
    description: "Test-only PreferenceTestDate for semantic composition preferences."
    display_name: "PreferenceTestDate"
    display_plural: "PreferenceTestDate items"
    plural: "PreferenceTestDateItems"
  }
}

property PreferenceTestDate.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value PreferenceTestDate.StringValueType
