meta {
  export_mode: "test-fixture"
  load_with: ["../core/root.json","../core/concrete-value-types.json"]
}

schema BookAuthorInverseSchema {
  depends_on "MAP Core Schema-v0.0.7"
  header {
    description: "Minimal test schema with an inverse relationship and extending the core schema."
  }
}

holon Book.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "A book."
    display_name: "Book"
    display_plural: "Books"
    plural: "Books"
  }
  relationships {
    InstanceProperties -> [Title.PropertyType, IsPublished.PropertyType, PageCount.PropertyType, PublicationStatus.PropertyType, CoverDigest.PropertyType, Subtitle.PropertyType, ContentDigest.PropertyType, ShortText.PropertyType, SignedScore.PropertyType, ShortBytes.PropertyType]
    InstanceRelationships -> [
      (Book.HolonType)-[AuthoredBy]->(Person.HolonType),
      (Book.HolonType)-[ReferencesProperty]->(PropertyType.TypeDescriptor)
    ]
  }
}

relationship (Book.HolonType)-[ReferencesProperty]->(PropertyType.TypeDescriptor) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
    HasInverse -> ReferencedByBook
  }
  extends DeclaredRelationshipType.RelationshipType
  source Book.HolonType
  target PropertyType.TypeDescriptor
  deletion_semantic Allow
  header {
    description: "Non-definitional test relationship used to verify graph-only update anchoring and duplicate suppression."
    display_name: "ReferencesProperty"
    display_plural: "ReferencesProperty Relationships"
    plural: "ReferencesPropertyRelationships"
  }
}

inverse relationship (PropertyType.TypeDescriptor)-[ReferencedByBook]->(Book.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source PropertyType.TypeDescriptor
  target Book.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Inverse of ReferencesProperty for graph-only update tests."
    display_name: "ReferencedByBook"
    display_plural: "ReferencedByBook Relationships"
    plural: "ReferencedByBookRelationships"
  }
}

holon Person.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "A person."
    display_name: "Person"
    display_plural: "People"
    plural: "Persons"
  }
  relationships {
    InstanceProperties -> Name.PropertyType
  }
}

def relationship (Book.HolonType)-[AuthoredBy]->(Person.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
    HasInverse -> AuthorOf
  }
  extends DeclaredRelationshipType.RelationshipType
  source Book.HolonType
  target Person.HolonType
  deletion_semantic Allow
  header {
    description: "Defines the author of a book."
    display_name: "AuthoredBy"
    display_plural: "AuthoredBy Relationships"
    plural: "AuthoredByRelationships"
  }
}

inverse relationship (Person.HolonType)-[AuthorOf]->(Book.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source Person.HolonType
  target Book.HolonType
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  deletion_semantic Block
  header {
    description: "Specifies a book that a Person has authored. Inverse of AuthoredBy."
    display_name: "AuthorOf"
    display_plural: "AuthorOf Relationships"
    plural: "AuthorOfRelationships"
  }
}

property Name.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  header {
    description: "Proper name."
    display_name: "Name"
    display_plural: "Names"
    plural: "Names"
  }
}

property Title.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  IsValueRequired true
  header {
    description: "A title."
    display_name: "Title"
    display_plural: "Title"
    plural: "Titles"
  }
}

property IsPublished.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapBooleanValueType.BooleanValueType
  header {
    description: "Optional IsPublished for scalar presentation acceptance."
    display_name: "IsPublished"
    display_plural: "IsPublished"
    plural: "IsPublishedValues"
  }
}

property PageCount.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapIntegerValueType.IntegerValueType
  header {
    description: "Optional PageCount for scalar presentation acceptance."
    display_name: "PageCount"
    display_plural: "PageCount"
    plural: "PageCountValues"
  }
}

property PublicationStatus.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value PublicationStatus.MapEnumValueType
  header {
    description: "Optional PublicationStatus for scalar presentation acceptance."
    display_name: "PublicationStatus"
    display_plural: "PublicationStatus"
    plural: "PublicationStatusValues"
  }
}

property CoverDigest.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapBytesValueType.BytesValueType
  header {
    description: "Optional CoverDigest for scalar presentation acceptance."
    display_name: "CoverDigest"
    display_plural: "CoverDigest"
    plural: "CoverDigestValues"
  }
}

property ContentDigest.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value ContentDigestValueType.MapBytesValueType
  header {
    description: "Optional ContentDigest whose bytes value type explicitly affords Equals."
    display_name: "ContentDigest"
    display_plural: "ContentDigest"
    plural: "ContentDigestValues"
  }
}

value ContentDigestValueType.MapBytesValueType {
  type MetaBytesValueType.MetaValueType
  extends MapBytesValueType.BytesValueType
  header {
    description: "Test bytes value type that explicitly affords Equals, which canonical MapBytesValueType does not."
    display_name: "ContentDigestValueType"
    display_plural: "ContentDigestValueTypes"
    plural: "ContentDigestValueTypes"
  }
  relationships {
    AffordsOperator -> EqualsOperator.OperatorType
  }
}

property Subtitle.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  header {
    description: "Optional Subtitle for scalar presentation acceptance."
    display_name: "Subtitle"
    display_plural: "Subtitle"
    plural: "SubtitleValues"
  }
}

enum PublicationStatus.MapEnumValueType {
  type MetaEnumValueType.MetaValueType
  extends MapEnumValueType.EnumValueType
  header {
    description: "Publication state for Book value presentation."
    display_name: "PublicationStatus"
    display_plural: "PublicationStatuses"
    plural: "PublicationStatuses"
  }
  variants {
    variant Draft {
      type MetaEnumVariantValueType.MetaValueType
      extends MapEnumVariantValueType.EnumVariantValueType
      header {
        description: "Not yet published."
        display_name: "Draft"
      }
    }
    variant Published {
      type MetaEnumVariantValueType.MetaValueType
      extends MapEnumVariantValueType.EnumVariantValueType
      header {
        description: "Published edition."
        display_name: "Published"
      }
    }
  }
}

// Tight bounds make scalar rejection observable below PVL's representation limits.
instance ShortText.StringLengthConstraint {
  type StringLengthConstraint.ConstraintType
  rule_of BookAuthorInverseSchema
  ConstraintName "ShortText"
  Minimum 1
  Maximum 5
  MinimumIsInclusive true
  MaximumIsInclusive true
}

instance SignedScore.NumericRangeConstraint {
  type NumericRangeConstraint.ConstraintType
  rule_of BookAuthorInverseSchema
  ConstraintName "SignedScore"
  Minimum -5
  Maximum 5
  MinimumIsInclusive true
  MaximumIsInclusive true
}

instance ShortBytes.BytesLengthConstraint {
  type BytesLengthConstraint.ConstraintType
  rule_of BookAuthorInverseSchema
  ConstraintName "ShortBytes"
  Maximum 3
  MaximumIsInclusive true
}

value ShortText.MapStringValueType {
  type MetaStringValueType.MetaValueType
  extends MapStringValueType.StringValueType
  header {
    description: "Scalar constraint acceptance fixture."
    display_name: "ShortText"
  }
  relationships {
    Constraints -> ShortText.StringLengthConstraint
  }
}

value SignedScore.MapIntegerValueType {
  type MetaIntegerValueType.MetaValueType
  extends MapIntegerValueType.IntegerValueType
  header {
    description: "Scalar constraint acceptance fixture."
    display_name: "SignedScore"
  }
  relationships {
    Constraints -> SignedScore.NumericRangeConstraint
  }
}

value ShortBytes.MapBytesValueType {
  type MetaBytesValueType.MetaValueType
  extends MapBytesValueType.BytesValueType
  header {
    description: "Scalar constraint acceptance fixture."
    display_name: "ShortBytes"
  }
  relationships {
    Constraints -> ShortBytes.BytesLengthConstraint
  }
}

property ShortText.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  header {
    description: "Scalar constraint acceptance fixture."
    display_name: "ShortText"
  }
  value ShortText.MapStringValueType
}

property SignedScore.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  header {
    description: "Scalar constraint acceptance fixture."
    display_name: "SignedScore"
  }
  value SignedScore.MapIntegerValueType
}

property ShortBytes.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  header {
    description: "Scalar constraint acceptance fixture."
    display_name: "ShortBytes"
  }
  value ShortBytes.MapBytesValueType
}

holon ScalarTestMetaType.MetaHolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends MetaHolonType.MetaTypeDescriptor
  header {
    description: "Scalar constraint acceptance fixture."
    display_name: "ScalarTestMetaType"
  }
  relationships {
    InstanceProperties -> ShortText.PropertyType
  }
}

value ShortTextChild.ShortText {
  type MetaStringValueType.MetaValueType
  extends ShortText.MapStringValueType
  header {
    description: "Scalar constraint acceptance fixture."
    display_name: "ShortTextChild"
  }
}
