meta {
  export_mode: "test-fixture"
  load_with: ["../core/root.json","../core/concrete-value-types.json"]
}

schema BookAuthorInverseSchema {
  depends_on "MAP Core Schema-v0.0.7"
  header {
    description: "Minimal test schema with an inverse relationship and extending the core schema."
  }
}

holon Book.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "A book."
    display_name: "Book"
    display_plural: "Books"
    plural: "Books"
  }
  relationships {
    InstanceProperties -> Title.PropertyType
    InstanceRelationships -> [
      (Book.HolonType)-[AuthoredBy]->(Person.HolonType),
      (Book.HolonType)-[ReferencesProperty]->(PropertyType.TypeDescriptor)
    ]
  }
}

relationship (Book.HolonType)-[ReferencesProperty]->(PropertyType.TypeDescriptor) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    HasInverse -> ReferencedByBook
  }
  extends DeclaredRelationshipType.RelationshipType
  source Book.HolonType
  target PropertyType.TypeDescriptor
  cardinality 0..*
  deletion_semantic Allow
  header {
    description: "Non-definitional test relationship used to verify graph-only update anchoring and duplicate suppression."
    display_name: "ReferencesProperty"
    display_plural: "ReferencesProperty Relationships"
    plural: "ReferencesPropertyRelationships"
  }
}

inverse relationship (PropertyType.TypeDescriptor)-[ReferencedByBook]->(Book.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source PropertyType.TypeDescriptor
  target Book.HolonType
  cardinality 0..*
  deletion_semantic Block
  header {
    description: "Inverse of ReferencesProperty for graph-only update tests."
    display_name: "ReferencedByBook"
    display_plural: "ReferencedByBook Relationships"
    plural: "ReferencedByBookRelationships"
  }
}

holon Person.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "A person."
    display_name: "Person"
    display_plural: "People"
    plural: "Persons"
  }
  relationships {
    InstanceProperties -> Name.PropertyType
  }
}

def relationship (Book.HolonType)-[AuthoredBy]->(Person.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    HasInverse -> AuthorOf
  }
  extends DeclaredRelationshipType.RelationshipType
  source Book.HolonType
  target Person.HolonType
  cardinality 0..*
  deletion_semantic Allow
  header {
    description: "Defines the author of a book."
    display_name: "AuthoredBy"
    display_plural: "AuthoredBy Relationships"
    plural: "AuthoredByRelationships"
  }
}

inverse relationship (Person.HolonType)-[AuthorOf]->(Book.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source Person.HolonType
  target Book.HolonType
  cardinality 0..*
  deletion_semantic Block
  header {
    description: "Specifies a book that a Person has authored. Inverse of AuthoredBy."
    display_name: "AuthorOf"
    display_plural: "AuthorOf Relationships"
    plural: "AuthorOfRelationships"
  }
}

property Name.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  header {
    description: "Proper name."
    display_name: "Name"
    display_plural: "Names"
    plural: "Names"
  }
}

property Title.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapStringValueType.StringValueType
  header {
    description: "A title."
    display_name: "Title"
    display_plural: "Title"
    plural: "Titles"
  }
}
