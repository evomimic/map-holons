schema "MAP Core Schema-v0.0.7" {
  depends_on "MAP Key Rule Schema"
}

holon MetaValueType.MetaTypeDescriptor {
  type MetaHolonType.MetaTypeDescriptor
  extends MetaTypeDescriptor.HolonType
  header {
    description: "Common meta-type describing value-type descriptor holons."
    display_name: "Meta Value Type"
    display_plural: "Meta Value Types"
    plural: "MetaValueTypes"
  }
  relationships {
    InstanceRelationships -> [
      (ValueType.TypeDescriptor)-[AffordsOperator]->(OperatorType.HolonType)
    ]
  }
}

holon MetaEnumVariantValueType.MetaValueType {
  type MetaHolonType.MetaTypeDescriptor
  instance_keyrule EnumVariantRule.KeyRuleType
  extends MetaValueType.MetaTypeDescriptor
  header {
    description: "Meta-type describing concrete enum-member descriptor holons and prescribing owner-qualified descriptor keys."
    display_name: "Meta Enum Variant Value Type"
    display_plural: "Meta Enum Variant Value Types"
    plural: "MetaEnumVariantValueTypes"
  }
}

holon MetaStringValueType.MetaValueType {
  type MetaHolonType.MetaTypeDescriptor
  extends MetaValueType.MetaTypeDescriptor
  header {
    description: "Meta-type describing string value-type descriptor holons."
    display_name: "Meta String Value Type"
    display_plural: "Meta String Value Types"
    plural: "MetaStringValueTypes"
  }
  relationships {
    InstanceRelationships -> [
      (StringValueType.ValueType)-[Constraints]->(StringValueConstraint.ValueConstraintType)
    ]
  }
}

holon MetaIntegerValueType.MetaValueType {
  type MetaHolonType.MetaTypeDescriptor
  extends MetaValueType.MetaTypeDescriptor
  header {
    description: "Meta-type describing integer value-type descriptor holons."
