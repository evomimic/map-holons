holon MetaBytesValueType.MetaValueType {
  type MetaHolonType.MetaTypeDescriptor
  extends MetaValueType.MetaTypeDescriptor
  header {
    description: "Meta-type describing byte-sequence value-type descriptor holons."
    display_name: "Meta Bytes Value Type"
    display_plural: "Meta Bytes Value Types"
    plural: "MetaBytesValueTypes"
  }
  relationships {
    InstanceRelationships -> [
      (BytesValueType.ValueType)-[Constraints]->(BytesValueConstraint.ValueConstraintType)
