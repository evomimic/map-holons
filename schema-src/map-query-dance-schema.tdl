meta {
  export_mode: "design-seed"
  source_files: ["docs/core/map-queries/query-dance-adapter-schema-tdl.md","docs/core/map-queries/query-engine-design-spec.md","docs/core/map-queries/queries-impl-plan.md"]
  load_with: ["map-core-schema-root.json","map-core-schema-dance-schema.json","map-query-schema.json"]
}

schema "MAP Query Dance Adapter Schema-v0.1.0" {
  depends_on "MAP Core Schema-v0.0.7"
  depends_on "MAP Query Schema-v0.0.2"
  header {
    description: "Dance-layer adapter descriptors for invoking an independently usable Query. Dance descriptors are currently packaged by MAP Core Schema."
  }
}

holon QueryDanceRequest.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  header {
    description: "Dance ingress request selecting a Query and providing its initial collection and parameter bindings."
    display_name: "Query Dance Request"
    display_plural: "Query Dance Requests"
    plural: "QueryDanceRequests"
  }
  relationships {
    InstanceRelationships -> [
      (QueryDanceRequest.HolonType)-[RequestedQuery]->(Query.HolonType),
      (QueryDanceRequest.HolonType)-[InitialInput]->(HolonCollection.HolonType),
      (QueryDanceRequest.HolonType)-[RequestParameters]->(QueryParameterBinding.HolonType)
    ]
  }
}

holon QueryDanceResponse.DanceResponseType {
  type MetaDanceResponseType.MetaHolonType
  extends DanceResponseType.HolonType
  header {
    description: "Dance response wrapping a Query result collection."
    display_name: "Query Dance Response"
    display_plural: "Query Dance Responses"
    plural: "QueryDanceResponses"
  }
  relationships {
    ResponseBody -> HolonCollection.HolonType
  }
}

holon MetaQueryDanceType.MetaHolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends MetaDanceType.MetaHolonType
  header {
    description: "Adapter-owned meta-type for QueryDance descriptors, including the HolonSpace affordance contract."
    display_name: "Meta Query Dance Type"
    display_plural: "Meta Query Dance Types"
    plural: "MetaQueryDanceTypes"
  }
  relationships {
    InstanceRelationships -> (QueryDance.DanceType)-[DanceAffordedBy]->(HolonSpace.HolonType)
  }
}

holon QueryDance.DanceType {
  type MetaQueryDanceType.MetaHolonType
  extends DanceType.HolonType
  DanceDescription "Adapts a Dance invocation onto direct execution of a Query."
  header {
    description: "Dance adapter for Query execution. It does not define the Query engine or bind a DanceImplementation."
    display_name: "Query Dance"
    display_plural: "Query Dances"
    plural: "QueryDances"
  }
  relationships {
    DanceInput -> QueryDanceRequest.HolonType
    Response -> QueryDanceResponse.DanceResponseType
    DanceAffordedBy -> HolonSpace.HolonType
  }
}

def relationship (QueryDance.DanceType)-[DanceAffordedBy]->(HolonSpace.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    HasInverse -> AffordsDance
  }
  extends DeclaredRelationshipType.RelationshipType
  source QueryDance.DanceType
  target HolonSpace.HolonType
  cardinality 0..*
  deletion_semantic Block
  header {
    description: "Declares that the QueryDance adapter is afforded by the HolonSpace."
    display_name: "Query Dance Afforded By HolonSpace Relationship"
    display_plural: "Query Dance Afforded By HolonSpace Relationships"
    plural: "QueryDanceAffordedByHolonSpaceRelationships"
  }
}

inverse relationship (HolonSpace.HolonType)-[AffordsDance]->(QueryDance.DanceType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source HolonSpace.HolonType
  target QueryDance.DanceType
  cardinality 0..*
  deletion_semantic Allow
  header {
    description: "Inverse of the QueryDance DanceAffordedBy relationship for HolonSpace."
    display_name: "HolonSpace Affords Query Dance Relationship"
    display_plural: "HolonSpace Affords Query Dance Relationships"
    plural: "HolonSpaceAffordsQueryDanceRelationships"
  }
}

def relationship (QueryDanceRequest.HolonType)-[RequestedQuery]->(Query.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    HasInverse -> QueryRequestedBy
  }
  extends DeclaredRelationshipType.RelationshipType
  source QueryDanceRequest.HolonType
  target Query.HolonType
  cardinality 1..1
  deletion_semantic Block
  header {
    description: "Selects the Query executed by a Dance-mediated request."
    display_name: "Requested Query"
    display_plural: "Requested Queries"
    plural: "RequestedQueries"
  }
}

inverse relationship (Query.HolonType)-[QueryRequestedBy]->(QueryDanceRequest.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source Query.HolonType
  target QueryDanceRequest.HolonType
  cardinality 0..*
  deletion_semantic Block
  header {
    description: "Inverse of RequestedQuery."
    display_name: "Query Requested By"
    display_plural: "Queries Requested By"
    plural: "QueriesRequestedBy"
  }
}

def relationship (QueryDanceRequest.HolonType)-[InitialInput]->(HolonCollection.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    HasInverse -> InitialInputForQueryDanceRequest
  }
  extends DeclaredRelationshipType.RelationshipType
  source QueryDanceRequest.HolonType
  target HolonCollection.HolonType
  cardinality 1..1
  deletion_semantic Block
  header {
    description: "Supplies the initial collection for a Dance-mediated Query invocation."
    display_name: "Initial Input"
    display_plural: "Initial Inputs"
    plural: "InitialInputs"
  }
}

inverse relationship (HolonCollection.HolonType)-[InitialInputForQueryDanceRequest]->(QueryDanceRequest.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source HolonCollection.HolonType
  target QueryDanceRequest.HolonType
  cardinality 0..*
  deletion_semantic Block
  header {
    description: "Inverse of InitialInput."
    display_name: "Initial Input For Query Dance Request"
    display_plural: "Initial Inputs For Query Dance Requests"
    plural: "InitialInputsForQueryDanceRequests"
  }
}

def relationship (QueryDanceRequest.HolonType)-[RequestParameters]->(QueryParameterBinding.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    HasInverse -> ParametersForQueryDanceRequest
  }
  extends DeclaredRelationshipType.RelationshipType
  source QueryDanceRequest.HolonType
  target QueryParameterBinding.HolonType
  cardinality 0..*
  deletion_semantic Block
  header {
    description: "Supplies invocation-specific bindings to a Dance-mediated Query."
    display_name: "Request Parameters"
    display_plural: "Request Parameters"
    plural: "RequestParameters"
  }
}

inverse relationship (QueryParameterBinding.HolonType)-[ParametersForQueryDanceRequest]->(QueryDanceRequest.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source QueryParameterBinding.HolonType
  target QueryDanceRequest.HolonType
  cardinality 0..*
  deletion_semantic Block
  header {
    description: "Inverse of RequestParameters."
    display_name: "Parameters For Query Dance Request"
    display_plural: "Parameters For Query Dance Requests"
    plural: "ParametersForQueryDanceRequests"
  }
}
