schema "MAP Descriptor Runtime Schema-v0.1.0" {
  depends_on "MAP Core Schema-v0.0.7"
  depends_on "MAP Dance Schema-v0.1.0"
  depends_on "MAP Commands Schema-v0.1.0"
  header {
    description: "Transient effective schema products, contribution provenance, and their construction Dance."
  }
}

holon EffectiveHolonDescriptor.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  instance_keyrule NoneRule.KeyRuleType
  header {
    description: "Transaction-scoped derived schema result."
    display_name: "EffectiveHolonDescriptor"
    plural: "EffectiveHolonDescriptors"
  }
  relationships {
    InstanceProperties -> PreparedSchema.PropertyType
    InstanceRelationships -> [
      (EffectiveHolonDescriptor.HolonType)-[DescribedHolonType]->(HolonType.TypeDescriptor),
      (EffectiveHolonDescriptor.HolonType)-[EffectiveInstanceProperties]->(PropertyType.TypeDescriptor),
      (EffectiveHolonDescriptor.HolonType)-[EffectiveInstanceRelationships]->(DeclaredRelationshipType.RelationshipType),
      (EffectiveHolonDescriptor.HolonType)-[SingularNavigableRelationships]->(RelationshipType.TypeDescriptor),
      (EffectiveHolonDescriptor.HolonType)-[PluralNavigableRelationships]->(RelationshipType.TypeDescriptor),
      (EffectiveHolonDescriptor.HolonType)-[EffectiveAffordsDance]->(DanceType.HolonType),
      (EffectiveHolonDescriptor.HolonType)-[EffectiveAffordsCommand]->(CommandType.HolonType),
      (EffectiveHolonDescriptor.HolonType)-[EffectiveValidationBindings]->(ValidationRule.HolonType),
      (EffectiveHolonDescriptor.HolonType)-[EffectiveConstraints]->(Constraint.HolonType),
      (EffectiveHolonDescriptor.HolonType)-[EffectiveInstanceKeyRule]->(HolonType.TypeDescriptor),
      (EffectiveHolonDescriptor.HolonType)-[EffectiveContributions]->(EffectiveSchemaContribution.HolonType)
    ]
  }
}

holon EffectiveSchemaContribution.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  instance_keyrule NoneRule.KeyRuleType
  header {
    description: "Records one contributed schema member, its source collection, declaring type, and position."
    display_name: "EffectiveSchemaContribution"
    plural: "EffectiveSchemaContributions"
  }
  relationships {
    InstanceProperties -> ContributionPosition.PropertyType
    InstanceRelationships -> [
      (EffectiveSchemaContribution.HolonType)-[ContributionCollection]->(RelationshipType.TypeDescriptor),
      (EffectiveSchemaContribution.HolonType)-[ContributionMember]->(HolonType.TypeDescriptor),
      (EffectiveSchemaContribution.HolonType)-[ContributionDeclaredOn]->(HolonType.TypeDescriptor)
    ]
  }
}

property ContributionPosition.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapIntegerValueType.IntegerValueType
  IsValueRequired true
  header {
    description: "Zero-based position within one source collection's contribution sequence."
    display_name: "Contribution Position"
    plural: "ContributionPositions"
  }
}

