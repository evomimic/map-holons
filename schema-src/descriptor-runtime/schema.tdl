  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  instance_keyrule NoneRule.KeyRuleType
  header {
    description: "Request for the resolved schema of exactly one HolonType."
    display_name: "Construct Effective Descriptor Request"
    plural: "ConstructEffectiveHolonDescriptorRequests"
  }
  relationships {
    InstanceRelationships -> (ConstructEffectiveHolonDescriptorRequest.HolonType)-[RequestedHolonType]->(HolonType.TypeDescriptor)
  }
}

holon ConstructEffectiveHolonDescriptorResponse.DanceResponseType {
  type MetaDanceResponseType.MetaHolonType
  extends DanceResponseType.HolonType
  relationships {
    ResponseBody -> EffectiveHolonDescriptor.HolonType
    InstanceRelationships -> (DanceResponseType.HolonType)-[ResponseBody]->(HolonType.TypeDescriptor)
  }
  header {
    description: "Response carrying a transient resolved schema graph."
    display_name: "Construct Effective Descriptor Response"
    plural: "ConstructEffectiveHolonDescriptorResponses"
  }
}

holon ConstructEffectiveHolonDescriptor.DanceType {
  type MetaDanceType.MetaHolonType
  extends DanceType.HolonType
  RequiredExecutionContext SpaceAuthoritative
  DanceDescription "Constructs a transaction-scoped resolved schema without allocating contribution Holons."
  relationships {
    RequestType -> ConstructEffectiveHolonDescriptorRequest.HolonType
    Response -> ConstructEffectiveHolonDescriptorResponse.DanceResponseType
    DanceAffordedBy -> HolonSpace.HolonType
  }
  header {
    description: "Resolve the complete schema of a HolonType once in the authoritative Space."
    display_name: "Construct Effective Descriptor"
    plural: "ConstructEffectiveHolonDescriptorDances"
  }
}

instance ConstructEffectiveHolonDescriptor.DanceImplementation {
  type DanceImplementation.HolonType
  ImplementationName "ConstructEffectiveHolonDescriptor"
  relationships {
    ForDance -> ConstructEffectiveHolonDescriptor.DanceType
  }
}

