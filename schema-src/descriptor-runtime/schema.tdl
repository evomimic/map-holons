schema "MAP Descriptor Runtime Schema-v0.1.0" {
  depends_on "MAP Core Schema-v0.0.7"
  depends_on "MAP Dance Schema-v0.1.0"
  depends_on "MAP Commands Schema-v0.1.0"
  header {
    description: "Transient effective schema products, contribution provenance, and their construction Dance."
  }
}

holon EffectiveDescriptor.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  instance_keyrule NoneRule.KeyRuleType
  header {
    description: "Transaction-scoped derived schema result."
    display_name: "EffectiveDescriptor"
    plural: "EffectiveDescriptors"
  }
  relationships {
    InstanceRelationships -> [
      (EffectiveDescriptor.HolonType)-[DescribedHolonType]->(HolonType.TypeDescriptor),
      (EffectiveDescriptor.HolonType)-[EffectiveInstanceProperties]->(PropertyType.TypeDescriptor),
      (EffectiveDescriptor.HolonType)-[EffectiveInstanceRelationships]->(DeclaredRelationshipType.RelationshipType),
      (EffectiveDescriptor.HolonType)-[NavigableRelationships]->(RelationshipType.TypeDescriptor),
      (EffectiveDescriptor.HolonType)-[EffectiveAffordsDance]->(DanceType.HolonType),
      (EffectiveDescriptor.HolonType)-[EffectiveAffordsCommand]->(CommandType.HolonType),
      (EffectiveDescriptor.HolonType)-[EffectiveValidationBindings]->(ValidationRule.HolonType),
      (EffectiveDescriptor.HolonType)-[EffectiveConstraints]->(Constraint.HolonType),
      (EffectiveDescriptor.HolonType)-[EffectiveInstanceKeyRule]->(HolonType.TypeDescriptor),
      (EffectiveDescriptor.HolonType)-[EffectiveContributions]->(EffectiveSchemaContribution.HolonType)
    ]
  }
}

holon EffectiveSchemaContribution.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  instance_keyrule NoneRule.KeyRuleType
  header {
    description: "Records one contributed schema member, its source collection, declaring type, and position."
    display_name: "EffectiveSchemaContribution"
    plural: "EffectiveSchemaContributions"
  }
  relationships {
    InstanceProperties -> ContributionPosition.PropertyType
    InstanceRelationships -> [
      (EffectiveSchemaContribution.HolonType)-[ContributionCollection]->(RelationshipType.TypeDescriptor),
      (EffectiveSchemaContribution.HolonType)-[ContributionMember]->(HolonType.TypeDescriptor),
      (EffectiveSchemaContribution.HolonType)-[ContributionDeclaredOn]->(HolonType.TypeDescriptor)
    ]
  }
}

property ContributionPosition.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapIntegerValueType.IntegerValueType
  IsValueRequired true
  header {
    description: "Zero-based position within one source collection's contribution sequence."
    display_name: "Contribution Position"
    plural: "ContributionPositions"
  }
}

def relationship (EffectiveDescriptor.HolonType)-[DescribedHolonType]->(HolonType.TypeDescriptor) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  extends DeclaredRelationshipType.RelationshipType
  source EffectiveDescriptor.HolonType
  target HolonType.TypeDescriptor
  TargetBinding Version
  IsOrdered false
  AllowsDuplicates false
  deletion_semantic Block
  relationships {
    Constraints -> ExactlyOne.CardinalityConstraint
    HasInverse -> (HolonType.TypeDescriptor)-[EffectiveDescriptorFor]->(EffectiveDescriptor.HolonType)
  }
  header {
    description: "Derived schema result relationship DescribedHolonType."
    display_name: "DescribedHolonType"
    plural: "DescribedHolonType"
  }
}

inverse relationship (HolonType.TypeDescriptor)-[EffectiveDescriptorFor]->(EffectiveDescriptor.HolonType) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source HolonType.TypeDescriptor
