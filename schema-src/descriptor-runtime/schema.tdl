  TargetBinding Version
  IsDefinitional true
  IsOrdered false
  AllowsDuplicates false
  deletion_semantic Block
  relationships {
    Constraints -> ZeroOrMore.CardinalityConstraint
  }
  header {
    description: "Inverse discovery for DescribedHolonType."
    display_name: "EffectiveDescriptorFor"
    plural: "EffectiveDescriptorFor"
  }
}

