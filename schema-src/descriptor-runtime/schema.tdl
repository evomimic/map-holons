property IncludeContributions.PropertyType {
  type MetaPropertyType.MetaTypeDescriptor
  extends PropertyType.TypeDescriptor
  value MapBooleanValueType.BooleanValueType
  header {
    description: "Opt in to contribution Holon materialization; omission means false."
    display_name: "Include Contributions"
    plural: "IncludeContributions"
  }
}

holon ConstructEffectiveDescriptorRequest.HolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends HolonType.TypeDescriptor
  instance_keyrule NoneRule.KeyRuleType
  header {
    description: "Request for the resolved schema of exactly one HolonType."
    display_name: "Construct Effective Descriptor Request"
    plural: "ConstructEffectiveDescriptorRequests"
  }
  relationships {
    InstanceProperties -> IncludeContributions.PropertyType
    InstanceRelationships -> (ConstructEffectiveDescriptorRequest.HolonType)-[RequestedHolonType]->(HolonType.TypeDescriptor)
  }
}

holon ConstructEffectiveDescriptorResponse.DanceResponseType {
  type MetaDanceResponseType.MetaHolonType
  extends DanceResponseType.HolonType
  relationships {
    ResponseBody -> EffectiveDescriptor.HolonType
    InstanceRelationships -> (DanceResponseType.HolonType)-[ResponseBody]->(HolonType.TypeDescriptor)
  }
  header {
    description: "Response carrying a transient resolved schema graph."
    display_name: "Construct Effective Descriptor Response"
    plural: "ConstructEffectiveDescriptorResponses"
  }
}

holon ConstructEffectiveDescriptor.DanceType {
  type MetaDanceType.MetaHolonType
  extends DanceType.HolonType
  RequiredExecutionContext SpaceAuthoritative
  DanceDescription "Constructs a lossless transaction-scoped resolved schema; contribution Holons are opt-in."
  relationships {
    RequestType -> ConstructEffectiveDescriptorRequest.HolonType
    Response -> ConstructEffectiveDescriptorResponse.DanceResponseType
    DanceAffordedBy -> HolonSpace.HolonType
  }
  header {
    description: "Resolve the complete schema of a HolonType once in the authoritative Space."
    display_name: "Construct Effective Descriptor"
    plural: "ConstructEffectiveDescriptorDances"
  }
}

instance ConstructEffectiveDescriptor.DanceImplementation {
  type DanceImplementation.HolonType
  ImplementationName "ConstructEffectiveDescriptor"
  relationships {
    ForDance -> ConstructEffectiveDescriptor.DanceType
  }
}

