holon MetaOperatorType.MetaHolonType {
  type MetaHolonType.MetaTypeDescriptor
  extends MetaHolonType.MetaTypeDescriptor
  header {
    description: "Meta-type describing operator-type descriptor holons. Operator metadata belongs to the descriptor holons because operators are discovered and invoked through their descriptors rather than through runtime operator instances."
    display_name: "Meta Operator Type"
    display_plural: "Meta Operator Types"
    plural: "MetaOperatorTypes"
  }
  relationships {
    InstanceProperties -> [
      Arity.PropertyType,
      OperatorCategory.PropertyType
    ]
  }
}

abstract holon OperatorType.HolonType {
  type MetaOperatorType.MetaHolonType
  extends HolonType.TypeDescriptor
  DefinesInstanceTypeKind true
  header {
    description: "Abstract descriptor anchor for core-defined operators applicable to ValueTypes. Concrete operator descriptors carry the metadata used for validation, query construction, and filter expressions."
    display_name: "Operator Type"
    display_plural: "Operator Types"
    plural: "OperatorTypes"
  }
}

def relationship (ValueType.TypeDescriptor)-[AffordsOperator]->(OperatorType.HolonType) {
  type MetaDeclaredRelationshipType.MetaRelationshipType
  relationships {
    HasInverse -> AffordedBy
  }
  extends DeclaredRelationshipType.RelationshipType
  source ValueType.TypeDescriptor
  target OperatorType.HolonType
  cardinality 0..*
  deletion_semantic Block
  header {
    description: "Links a ValueType descriptor to the concrete operator descriptors available for that value type, supporting validation and query construction. Core operator targets may be populated on an abstract value-family anchor so that every specialization inherits them through Additive relationship semantics. A specialization retains those inherited affordances and may add distinct operators, but cannot replace or remove the core targets."
    display_name: "AffordsOperator Relationship"
    display_plural: "AffordsOperator Relationships"
    plural: "AffordsOperatorRelationships"
  }
}

inverse relationship (OperatorType.HolonType)-[AffordedBy]->(ValueType.TypeDescriptor) {
  type MetaInverseRelationshipType.MetaRelationshipType
  extends InverseRelationshipType.RelationshipType
  source OperatorType.HolonType
  target ValueType.TypeDescriptor
  cardinality 1..*
  deletion_semantic Block
  header {
    description: "Inverse of AffordsOperator, from a concrete operator descriptor to the value type descriptors that afford it."
    display_name: "AffordedBy Relationship"
    display_plural: "AffordedBy Relationships"
    plural: "AffordedByRelationships"
  }
}

enum OperatorCategory.MapEnumValueType {
  type MetaEnumValueType.MetaValueType
  extends MapEnumValueType.EnumValueType
  header {
    description: "Enum value type categorizing operators by semantic behavior."
    display_name: "Operator Category"
    display_plural: "Operator Categories"
    plural: "OperatorCategories"
  }
  variants {
    variant Equality {
      type MetaEnumVariantValueType.MetaValueType
      extends MapEnumVariantValueType.EnumVariantValueType
      header {
        description: "Operators that test whether two values of the same type are equal or unequal. Applicable to all scalar value types."
        display_name: "Equality"
      }
    }
    variant Ordering {
      type MetaEnumVariantValueType.MetaValueType
      extends MapEnumVariantValueType.EnumVariantValueType
      header {
        description: "Operators that compare the relative order of two values of the same type. Applicable only to value types with a defined total order."
        display_name: "Ordering"
      }
    }
  }
}

