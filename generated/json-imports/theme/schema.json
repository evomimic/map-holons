    {
      "key": "Theme.HolonType",
      "type": "MetaHolonType.MetaTypeDescriptor",
      "properties": {
        "TypeName": "Theme",
        "TypeNamePlural": "Themes",
        "DisplayName": "Theme",
        "DisplayNamePlural": "Themes",
        "Description": "A user-selectable, complete realization of one MetaDesignSystem's DesignToken vocabulary. It assigns concrete typed presentation values through ThemeTokenAssignments for every DesignToken the MetaDesignSystem defines, allowing a runtime to project the Theme once to CSS. Theme selection is person- and space-driven, independent of Dancer or application choice. The notion of a theme and token-value assignment is common design-system practice, but Theme and its relationship semantics are MAP-native rather than DTCG-standardized."
      },
      "relationships": [
        {
          "name": "Extends",
          "target": [
            {
              "$ref": "HolonType.TypeDescriptor"
            }
          ]
        },
        {
          "name": "ComponentOf",
          "target": [
            {
              "$ref": "MAP Theme Schema-v0.1.0"
            }
          ]
        },
        {
          "name": "InstanceProperties",
          "target": [
            {
              "$ref": "ThemeName.PropertyType"
            }
          ]
        },
        {
          "name": "InstanceRelationships",
          "target": [
            {
              "$ref": "(Theme.HolonType)-[ForMetaDesignSystem]->(MetaDesignSystem.HolonType)"
            },
            {
              "$ref": "(Theme.HolonType)-[HasThemeTokenAssignment]->(ThemeTokenAssignment.HolonType)"
            },
            {
              "$ref": "(Theme.HolonType)-[OfferedByHolonSpace]->(HolonSpace.HolonType)"
            }
          ]
        }
      ]
    },
